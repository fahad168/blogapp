<main class="max-w-[1920px] mx-auto relative h-screen container" id="indexFile" data-controller="modal-data" data-action="scroll@window->modal-data#movies_scroll" onload="init()">
  <%= render "shared/header" %>
  <div class="-mt-[88px]">
    <div class="relative h-screen">
      <h1>The player</h1>
      <div id="remoteVideo" style="width:320px;height:240px;border: 1px solid"></div>
      <input type="button" value="start" onClick="start()"/>
      <p id="status"></p>
<!--        <img src="<%#= ENV['TMBD_IMAGE_URL'] %>/original/<%#= @popular_movie['results'].first['backdrop_path'] %>" class="h-full w-full">-->
        <div class="absolute inset-x-0 h-[25rem] bottom-0 bg-gradient-to-t from-black to-transparent"></div>
    </div>
  </div>
  <div class="genre flex flex-col -mb-[15rem] bottom-0 w-full absolute">
    <div class="genre-content flex flex-row justify-between pl-8 pb-5">
      <p class="genre-title font-bold text-3xl cursor-pointer">Today Trending Movies</p>
    </div>
    <div class="flex flex-row overflow-x-auto">
      <% @trending['results']&.first(10)&.each_with_index do |playing, index| %>
        <%= render 'home/trending_card', playing: playing, index: index %>
      <% end %>
    </div>
  </div>
  <div class="genre flex flex-col bottom-0 w-full mt-[17rem]">
    <div class="genre-content flex flex-row justify-between pl-8 pb-5">
      <p class="genre-title font-bold text-3xl cursor-pointer">Action & Adventure</p>
      <button class="text-[red] place-self-center mr-6" onclick="openViewModal(<%= Genre.where(genre_name: %w[Action Adventure]).pluck(:genre_id) %>)">View All</button>
    </div>
    <div class="flex flex-row overflow-x-auto">
      <% @action_adventure['results']&.each do |playing| %>
        <%= render 'home/card', playing: playing %>
      <% end %>
    </div>
  </div>
  <div class="genre flex flex-col bottom-0 w-full mt-[2rem]">
    <div class="genre-content flex flex-row justify-between pl-8 pb-5">
      <p class="genre-title font-bold text-3xl cursor-pointer">Fantasy</p>
      <button class="text-[red] place-self-center mr-6" onclick="openViewModal(<%= Genre.where(genre_name: 'Fantasy').pluck(:genre_id) %>)">View All</button>
    </div>
    <div class="flex flex-row overflow-x-auto">
      <% @fantasy['results']&.each do |playing| %>
        <%= render 'home/card', playing: playing %>
      <% end %>
    </div>
  </div>
  <div class="genre flex flex-col bottom-0 w-full mt-[2rem]">
    <div class="genre-content flex flex-row justify-between pl-8 pb-5">
      <p class="genre-title font-bold text-3xl cursor-pointer">Horror</p>
      <button class="text-[red] place-self-center mr-6" onclick="openViewModal(<%= Genre.where(genre_name: 'Horror').pluck(:genre_id) %>)">View All</button>
    </div>
    <div class="flex flex-row overflow-x-auto">
      <% @horror['results']&.each do |playing| %>
        <%= render 'home/card', playing: playing %>
      <% end %>
    </div>
  </div>
  <div id="genre_loader" style="display: none; justify-content: space-evenly">
    <div class="loader">
      <div class="dot dot1"></div>
      <div class="dot dot2"></div>
      <div class="dot dot3"></div>
    </div>
  </div>
  <%= render 'home/movie_modal' %>
  <%= render 'movies/view_all_modal' %>
</main>
<%= javascript_include_tag('slick') %>
<%= javascript_include_tag('home/home_modal') %>

<script>
  $(document).ready(function () {
      localStorage.setItem('scroll_time', '0')
  })

  var remoteVideo;
  function hideViewModal(){
      $('#viewMovieModal').hide()
      document.getElementById('indexFile').style.overflow = ''
      $('#overlay').hide();
  }
  function init(){
      Flashphoner.init();
      remoteVideo = document.getElementById("remoteVideo");
  }

  function start() {
      Flashphoner.createSession({urlServer: "wss://wcs5-eu.flashphoner.com:8443"}).on(Flashphoner.constants.SESSION_STATUS.ESTABLISHED, function (session) {
          //session connected, start streaming
          startPlayback(session);
      }).on(Flashphoner.constants.SESSION_STATUS.DISCONNECTED, function () {
          setStatus("DISCONNECTED");
      }).on(Flashphoner.constants.SESSION_STATUS.FAILED, function () {
          setStatus("FAILED");
      });
  }

  function startPlayback(session) {
      session.createStream({
          name: "stream2229",
          display: remoteVideo,
          cacheLocalResources: true,
          receiveVideo: true,
          receiveAudio: true
      }).on(Flashphoner.constants.STREAM_STATUS.PLAYING, function (playStream) {
          setStatus(Flashphoner.constants.STREAM_STATUS.PLAYING);
      }).on(Flashphoner.constants.STREAM_STATUS.STOPPED, function () {
          setStatus(Flashphoner.constants.STREAM_STATUS.STOPPED);
      }).on(Flashphoner.constants.STREAM_STATUS.FAILED, function () {
          setStatus(Flashphoner.constants.STREAM_STATUS.FAILED);
      }).play();
  }

  function setStatus(status) {
      document.getElementById("status").innerHTML = status;
  }

  function openViewModal(genre_ids) {
      const loaderContainer = document.getElementById("loader-container");
      loaderContainer.style.display = "flex";
      var csrfToken = $('meta[name="csrf-token"]').attr('content');
      $.ajax({
          type: 'POST',
          url: 'specific_genre_movies',
          data: { authenticity_token: csrfToken, genre_ids: genre_ids },
          success: function (response) {
              var innerModal = $('#viewInnerModal')
              innerModal.empty()
              innerModal.append(response.entries)
              document.getElementById('viewMovieModal').style.display = 'flex'
              document.getElementById('viewMovieModal').style.justifyContent = 'center'
              localStorage.setItem('viewCurrentPage', '1')
              $('#overlay').show();
              loaderContainer.style.display = "none";
          }
      })
  }
</script>
