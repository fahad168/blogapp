<% content_for :keywords, "best movies, actors, seasons, genres, explore, search, tv_shows, episodes, movies, stream, watch, movie, season, shows, seasons, movies, streaming, world wrestling entertainment, entertainment, pakistani drama, drama. korean drama, chinese drama, turkish drama, hollywood, bollywood, lollywood, corn, netflix, prime, tmdb, imbd, youtube" %>
<% content_for :title, "MoviesCorn: Your Cinematic Playground for Movies - Explore Blockbusters, Classics, and Hidden Gems with an Unrivaled Streaming Experience" %>
<% content_for :meta_description, "Embark on a cinematic adventure with MoviesCorn - your go-to destination for an extensive collection of movies. From the latest releases to timeless classics, immerse yourself in a world of storytelling excellence. Stream, discover, and experience movie magic like never before, exclusively at MoviesCorn." %>
<% if @popular_movie['results'].present? %>
  <% content_for :images, "#{ENV['TMBD_IMAGE_URL']}/original/#{@popular_movie['results'].first['backdrop_path'].present? ? @popular_movie['results'].first['backdrop_path'] : @popular_movie['results'].first['poster_path']}" %>
<% end %>

<main class="max-w-[1920px] mx-auto relative h-screen container" id="indexFile" data-controller="modal-data" data-action="scroll@window->modal-data#movies_scroll" onload="init()">
  <%= render "shared/header" %>
  <div class="single-item -mt-[88px]">
    <% @popular_movie['results']&.each_with_index do |movie, index| %>
      <div class="relative h-screen">
        <div class="absolute flex flex-col justify-center lg:ml-[5rem] md:ml-[3rem] ml-10 w-[80%]" style="height: 100vh" id="popular_movies_responsive">
          <h1 class="texting lg:text-[6.25rem] md:text-[3rem] text-[2rem] w-full focus:outline-none line-clamp-1" id="texting" contenteditable data-heading="<%= movie['original_title'] %>">
            <%= movie['original_title'] %>
          </h1>
        </div>
        <div class="flex flex-col justify-center absolute lg:mt-[6rem] md:mt-[1rem] mt-[1rem] lg:ml-[5rem] ml-10 h-screen z-10" id="popular_play_responsive">
          <div class="flex flex-row">
            <button aria-label="play_button" class="play mr-5 items-center" onclick="open_movie('<%= movie['id'] %>')">
              <svg viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="md:w-[26px] w-[20px]">
                <path d="M424.4 214.7L72.4 6.6C43.8-10.3 0 6.1 0 47.9V464c0 37.5 40.7 60.1 72.4 41.3l352-208c31.4-18.5 31.5-64.1 0-82.6z" fill="currentColor"></path>
              </svg>
            </button>
            <button aria-label="view_details_button" class="btn_details mr-3" data-controller="modal-data" data-action="click->modal-data#get_movie_data" data-movie-id="<%= movie['id'] %>">View
              Details
            </button>
          </div>
        </div>
        <% if movie['backdrop_path'].present? %>
          <img src="<%= ENV['TMBD_IMAGE_URL'] %>/original/<%= movie['backdrop_path'] %>" class="h-full w-full" id="popular_image" alt="backdrop image" loading="lazy">
        <% else %>
          <img src="<%= ENV['TMBD_IMAGE_URL'] %>/original/<%= movie['poster_path'] %>" class="h-full w-full" id="popular_image" alt="poster image" loading="lazy">
        <% end %>
        <div class="absolute inset-x-0 h-[25rem] bottom-0 bg-gradient-to-t from-black to-transparent"></div>
      </div>
    <% end %>
  </div>
  <div class="genre flex flex-col lg:-mb-[15rem] mb-[2rem] bottom-0 w-full absolute">
    <div class="genre-content flex flex-row justify-between pl-8 pb-5">
      <h1 class="genre-title font-bold text-3xl cursor-pointer text-white">Today Trending Movies</h1>
    </div>
    <div class="flex flex-row overflow-x-auto">
      <% @trending['results']&.first(10)&.each_with_index do |playing, index| %>
        <%= render 'home/trending_card', playing: playing, index: index %>
      <% end %>
    </div>
  </div>
  <div class="genre flex flex-col bottom-0 w-full lg:mt-[17rem] mt-0">
    <div class="genre-content flex flex-row justify-between pl-8 pb-5">
      <h1 class="genre-title font-bold text-3xl cursor-pointer text-white">Upcoming Movies</h1>
      <button class="text-[red] place-self-center mr-6" onclick="openViewModal(<%= Genre.where(genre_name: 'Horror').pluck(:genre_id) %>)">View All</button>
    </div>
    <div class="flex flex-row overflow-x-auto">
      <% @upcoming['results']&.each do |playing| %>
        <%= render 'home/card', playing: playing, page: 'mt-0' %>
      <% end %>
    </div>
  </div>
  <div class="genre flex flex-col bottom-0 w-full mt-[2rem]">
    <div class="genre-content flex flex-row justify-between pl-8 pb-5">
      <h1 class="genre-title font-bold text-3xl cursor-pointer text-white">Action & Adventure</h1>
      <button class="text-[red] place-self-center mr-6" onclick="openViewModal(<%= Genre.where(genre_name: %w[Action Adventure]).pluck(:genre_id) %>)">View All</button>
    </div>
    <div class="flex flex-row overflow-x-auto">
      <% @action_adventure['results']&.each do |playing| %>
        <%= render 'home/card', playing: playing, page: 'mt-0' %>
      <% end %>
    </div>
  </div>
  <div class="genre flex flex-col bottom-0 w-full mt-[2rem]">
    <div class="genre-content flex flex-row justify-between pl-8 pb-5">
      <h1 class="genre-title font-bold text-3xl cursor-pointer text-white">Fantasy</h1>
      <button class="text-[red] place-self-center mr-6" onclick="openViewModal(<%= Genre.where(genre_name: 'Fantasy').pluck(:genre_id) %>)">View All</button>
    </div>
    <div class="flex flex-row overflow-x-auto">
      <% @fantasy['results']&.each do |playing| %>
        <%= render 'home/card', playing: playing, page: 'mt-0' %>
      <% end %>
    </div>
  </div>
  <div id="genre_loader" style="display: none; justify-content: space-evenly">
    <div class="loader">
      <div class="dot dot1"></div>
      <div class="dot dot2"></div>
      <div class="dot dot3"></div>
    </div>
  </div>
  <%= render 'home/movie_modal' %>
  <%= render 'movies/view_all_modal' %>
  <%= render 'home/movie_play_modal' %>
  <%= render 'home/one_touch_sign_in' %>
</main>
<%= javascript_include_tag('slick') %>
<%= javascript_include_tag('home/home_modal') %>
<%= javascript_include_tag('home/slick_play_modal') %>

<script>
  function hideViewModal(){
      $('#viewMovieModal').hide()
      document.getElementById('indexFile').style.overflow = ''
      $('#overlay').hide();
  }

  function openViewModal(genre_ids) {
      const loaderContainer = document.getElementById("loader-container");
      const overlay = document.getElementById("overlay");
      loaderContainer.style.display = "block";
      overlay.style.display = "block";
      overlay.classList.remove('hidden')
      var csrfToken = $('meta[name="csrf-token"]').attr('content');
      $.ajax({
          type: 'POST',
          url: 'specific_genre_movies',
          data: { authenticity_token: csrfToken, genre_ids: genre_ids },
          success: function (response) {
              var innerModal = $('#viewInnerModal')
              innerModal.empty()
              innerModal.append(response.entries)
              document.getElementById('viewMovieModal').style.display = 'flex'
              document.getElementById('viewMovieModal').style.justifyContent = 'center'
              localStorage.setItem('viewCurrentPage', '1')
              $('#overlay').show();
              loaderContainer.style.display = "none";
          }
      })
  }
</script>
