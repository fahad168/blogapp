<div class="genre flex flex-col bottom-0 w-full mt-[2rem]">
  <div class="genre-content flex flex-row justify-between pl-8 pb-5">
    <p class="genre-title font-bold text-3xl cursor-pointer"><%= @category1 %></p>
    <button class="text-[red] place-self-center mr-6" onclick="openViewModal(<%= TvGenre.where(genre_name: @category1).pluck(:genre_id) %>)">View All</button>
  </div>
  <div class="flex flex-row overflow-x-auto">
    <% @result1['results']&.each do |playing| %>
      <%= render 'home/tv_card', playing: playing %>
    <% end %>
  </div>
</div>

