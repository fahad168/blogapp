<p class="absolute text-7xl font-bold text-[red] mt-4 bg-[black]" style="height: 3rem; width: 3.2rem"><%= index + 1 %></p>
<% if playing['poster_path'].present? %>
  <img src="<%= ENV['TMBD_IMAGE_URL'] %>/w780/<%= playing['poster_path'] %>" alt="poster image">
<% else %>
  <img src="<%= asset_path('no_image_found.png') %>" alt="Poster Image">
<% end %>
<div class="descriptions flex flex-col justify-between">
  <h1 class="truncate font-bold text-xl"><%= playing['original_name'] %></h1>
  <p class="line-clamp-5"><%= playing['overview'] %></p>
  <div class="flex flex-row justify-between">
    <div class="flex flex-row"><p class="text-[red] font-bold">Rating:</p>
      <p class="ml-2 text-sm"><%= playing['vote_average'] %>/10</p></div>
    <div class="flex flex-row"><p class="text-[red] font-bold">Votes:</p>
      <p class="ml-2 text-sm"><%= playing['vote_count'] %></p></div>
    <% if playing['release_date'].present? %>
      <div class="flex flex-row"><p class="text-[red] font-bold">Year:</p>
        <p class="ml-2 text-sm"><%= playing['release_date'].split('-').first %></p>
      </div>
    <% elsif playing['first_air_date'].present? %>
      <div class="flex flex-row"><p class="text-[red] font-bold">Year:</p>
        <p class="ml-2 text-sm"><%= playing['first_air_date'].split('-').first %></p>
      </div>
    <% end %>
  </div>
</div>
