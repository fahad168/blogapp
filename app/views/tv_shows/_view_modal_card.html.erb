<% if @specific_genre.present? %>
  <% if !@specific_genre.is_a?(Array) %>
    <% @specific_genre['results']&.each do |playing| %>
      <%= render 'tv_shows/view_all_modal_card_data', playing: playing %>
    <% end %>
  <% else %>
    <% @specific_genre&.each do |playing| %>
      <%= render 'tv_shows/view_all_modal_card_data', playing: playing %>
    <% end %>
  <% end %>
<% else %>
  <p class="text-[red] text-2xl flex justify-center p-10 w-full"><%= @message %></p>
<% end %>
