      <hr>
      <% prev_blog = Blog.find_by(id: @blog.id - 1) %>
      <% next_blog = Blog.find_by(id: @blog.id + 1) %>
      <div class="w-full flex flex-row justify-between mt-5 mb-5">
        <% if prev_blog.present? %>
        <a href="/blogs/<%= prev_blog.title.split(' ').map(&:downcase).join('-') %>" class="flex flex-col justify-start">
          <p class="font-semibold text-[10px] text-[#73808E]">PREVIOUS BLOG</p>
          <div class="flex flex-row justify-start mt-2">
            <svg class="w-4 h-4 text-gray-800 dark:text-white mt-[4px] mr-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
              <path stroke="#1E205A" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5H1m0 0 4 4M1 5l4-4"/>
            </svg>
            <p class="text-[#1E205A] text-md font-semibold mr-3"><%= prev_blog.title.capitalize %></p>
          </div>
        </a>
        <% else %>
        <div></div>
        <% end %>
        <% if next_blog.present? %>
        <a href="/blogs/<%= next_blog.title.split(' ').map(&:downcase).join('-') %>" class="flex flex-col justify-start">
          <p class="font-semibold text-[10px] text-[#73808E] text-end">NEXT BLOG</p>
          <div class="flex flex-row justify-start mt-2">
            <p class="text-[#1E205A] text-md font-semibold">Testing Blog</p>
            <svg class="w-4 h-4 text-gray-800 dark:text-white mt-[4px] ml-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
              <path stroke="#1E205A" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9"/>
            </svg>
          </div>
        </a>
        <% else %>
          <div></div>
        <% end %>
      </div>
      <hr>
      <% if current_user.present? %>
        <%= form_with(url: comments_path, method: :create, html: { id: 'comment_form' }) do |form| %>
          <%= form.hidden_field :parent_comment_id, id: 'parent_comment_id' %>
          <%= render 'blogs/comment_form' %>
        <% end %>
        <div id="comments" class="mt-7">
        <% @blog.comments.where(parent_comment_id: nil).order('created_at DESC')&.each do |comment| %>
          <%= render 'blogs/comment', comment: comment %>
          <div id="child_comments_<%= comment.id %>" class="mt-3 ml-10" style="display: none">
            <% comment.child_comments&.each do |child_comment| %>
              <%= render 'blogs/comment', comment: child_comment %>
            <% end %>
          </div>
        <% end %>
      </div>
      <% else %>
        <div class="flex flex-col mt-10">
          <p class="text-center text-gray-400">Sign in to access full functionality, including viewing comments, commenting, and reacting on our blog posts.</p>
          <div class="flex flex-row justify-center mt-3">
            <a href="/users/sign_in" class="bg-gray-400 pl-10 pr-20 pt-2 pb-2 rounded-lg w-[20rem] hover:opacity-75">
              <p class="text-lg text-white text-center ml-7">Sign In</p>
            </a>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
<%= render 'blogs/emoji_bottom_drawer' %>

<script>
  $('#comment_form').on('submit', function (e) {
      e.preventDefault()
      var csrfToken = $('meta[name="csrf-token"]').attr('content');
      var formData = new FormData()
      var parent_comment_id = document.getElementById('parent_comment_id').value
      if (parent_comment_id !== "" || parent_comment_id !== null) {
          formData.append('parent_comment_id', parent_comment_id)
      }
      formData.append('comment_details', $('#editor .ql-editor').html())
      formData.append('blog_id', "<%= @blog.id %>")
      formData.append('authenticity_token', csrfToken);
      $.ajax({
          url: '/comments',
          type: 'POST',
          data: formData,
          processData: false,
          contentType: false,
          success: function (res) {
              if (res?.child_comment === true) {
                  var childCommentDiv = document.getElementById(`child_comments_inner_${res?.parent_comment_id}`)
                  childCommentDiv.insertAdjacentHTML('afterbegin', res?.entries);
                  childCommentDiv.style.display = 'block'
                  childCommentDiv.scrollIntoView({ behavior: 'smooth' })
                  document.getElementById(`view_comments_${res?.parent_comment_id}`).innerText = `Hide (${res?.child_comment_count})`
                  document.getElementById('replying_div').style.display = 'none'
                  document.getElementById('parent_comment_id').value = ""
              } else {
                  document.getElementById('comments').insertAdjacentHTML('afterbegin', res?.entries);
              }
              $('#editor .ql-editor').empty()
          }
      })

  })

  function reactOnBlog(id) {
      $.ajax({
          type: 'GET',
          url: `/blogs/${id}/like`,
          success: function (res) {
              document.getElementById('likes_count').innerText = res?.likes_count
          }
      })
  }
</script>
