<style>
    table {
        width: 100%;
        border-collapse: collapse;
    }

    td {
        border: 1px solid #dddddd;
        padding: 8px;
        text-align: left;
    }

    tr:nth-child(even) {
        background-color: #f2f2f2;
    }

    h1 {
        font-size: 2.125rem;
        font-weight: bold;
    }

    h2 {
        font-size: 1.875rem;
        font-weight: bold;
    }

    #show_content img {
        max-width: 50rem;
        border-radius: 20px;
        align-self: center;
    }

    .ql-code-block {
        background-color: black;
        color: white;
    }

    select {
        display: none;
    }

    .ql-video {
        max-width: 50rem;
        width: 50rem;
        height: 25rem;
        border-radius: 10px;
    }

    blockquote {
        font-style: italic;
        margin: 0;
        padding: 1em;
        /*border-left: 4px solid #ccc;*/
        /*background-color: #f9f9f9;*/
        position: relative;
    }

    /* Quotation marks */
    blockquote::before,
    blockquote::after {
        content: '"';
        font-size: 2em;
        color: #ccc;
        position: absolute;
    }

    blockquote::before {
        top: -0.4em;
        left: -0.6em;
    }

    blockquote::after {
        bottom: -0.6em;
        right: -0.4em;
    }

    .ql-code-block-container {
        border-radius: 10px;
        padding-top: 2rem;
    }

    .ql-code-block {
        padding-left: 1rem;
    }
</style>

