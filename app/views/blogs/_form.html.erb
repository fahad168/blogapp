<div class="grid grid-col-2 gap-4 px-60 pt-20">
  <div class="flex flex-col justify-start">
    <input class="hidden" value="<%= @blog.present? ? @blog.id : '' %>" id="blog_id">
    <label class="text-xl font-semibold">Title:</label>
    <input id="title" class="border border-[grey] w-auto p-3 rounded-xl mt-2 focus:ring-[#3B42A2] focus:border-2 focus:border-[#3B42A2] focus:outline-none" placeholder="Enter Your Title Here..." value="<%= @blog.present? ? @blog.title : '' %>">
    <p id="title_error" class="text-[red] text-lg"></p>
  </div>
  <div class="flex flex-col justify-start mt-5">
    <label class="text-xl font-semibold">Description:</label>
    <textarea id="description" rows="5" class="border border-[grey] w-auto p-3 rounded-xl mt-2 focus:ring-[#3B42A2] focus:border-2 focus:border-[red] focus:outline-none" placeholder="Short description about blog ..."><%= @blog.present? ? @blog.description : '' %></textarea>
    <div class="flex flex-row justify-between">
      <p id="description_error" class="text-[red] text-lg"></p>
      <p id="words_count" class="<%= @blog.present? ? "text-[#3B42A2]" :  "text-[red]"%> text-md"><%= @blog.present? ? @blog.description.size : 0 %>/300</p>
    </div>
  </div>
  <div class="flex flex-col justify-start mt-5">
    <div>
      <div class="flex flex-col">
        <label class="text-xl font-semibold ">Categories:</label>
        <div id="categories_show" class="pb-3">
          <% categories =  @blog&.categories&.present? ? JSON.parse(@blog.categories) || [] : [] %>
          <% categories&.each do |category| %>
            <div class="inline-block" id='<%= category %>'>
              <div class="flex flex-row bg-[#3FB7CB] rounded-lg p-2 ml-2 mt-2">
                <p class="text-white"><%= category.split('_').join(' ') %></p>
                <%= image_tag asset_path('close.svg'), class: "w-5 h-5 pt-1 cursor-pointer", onclick: "delete_categories('#{category}', 'fromView')" %>
              </div>
            </div>
          <% end %>
        </div>
        <input id="categories" name="categories" class="hidden" value="<%=  @blog.present? ? categories : '' %>">
        <div class="flex flex-row justify-start bg-gray-50 border border-[grey] text-gray-900 text-base rounded-lg outline-none block w-full py-3 px-3">
          <input type="text" id="input_categories" class="focus:outline-none bg-transparent w-[90%]" placeholder="Type in your categories here.." oninput="get_suggestions(this); show_add_button(this)">
          <button class="text-[#3FB7CB] underline ml-20" onclick="categories(this, 'from_input')" type="button" style="display: none" id="add_button">Add</button>
        </div>
        <div class="border rounded-lg border-gray-300 h-auto max-h-[15rem] overflow-y-scroll hidden" id="suggested_results">
        </div>
        <p id="categories_error" class="text-[red]"></p>
      </div>
    </div>
  </div>
  <label class="text-xl font-semibold mt-5">Thumbnail:</label>
  <div class="flex items-center justify-center w-full">
    <label for="dropzone-file" class="flex flex-col items-center justify-center w-full h-64 border-2 border-gray-300 border-dashed rounded-lg cursor-pointer bg-white hover:bg-gray-100" id="dropzone">
      <% if @blog.present? && @blog&.thumbnail&.attached? %>
        <img src="<%= url_for(@blog.thumbnail) %>" class="overflow-hidden opacity-100 object-cover" id="dropzone-file-show" loading="lazy">
      <% else %>
        <div class="flex flex-col items-center justify-center pt-5 pb-6" id="dropzone-file-show">
          <svg class="w-8 h-8 mb-4 text-gray-500 dark:text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 16">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 13h3a3 3 0 0 0 0-6h-.025A5.56 5.56 0 0 0 16 6.5 5.5 5.5 0 0 0 5.207 5.021C5.137 5.017 5.071 5 5 5a4 4 0 0 0 0 8h2.167M10 15V6m0 0L8 8m2-2 2 2"/>
          </svg>
          <p class="mb-2 text-sm text-gray-500 dark:text-gray-400"><span class="font-semibold">Click to upload</span> or drag and drop</p>
          <p class="text-xs text-gray-500 dark:text-gray-400">SVG, PNG, or JPG (minimum 500x800)</p>
        </div>
      <% end %>
      <input id="dropzone-file" name="thumbnail" type="file" class="hidden" accept="image/jpg, image/png, image/jpeg" />
    </label>
  </div>
  <p id="thumbnail_error" class="text-[red]"></p>
  <div class="flex flex-col justify-start">
    <label class="text-xl font-semibold">Details:</label>
    <div id="standalone-container" style="margin-top: 15px;">
