          </div>
          <div id="editor" style="height: 20rem; border-bottom-left-radius: 20px; border-bottom-right-radius: 20px">
          </div>
          <p id="details-error" class="text-[red] mb-[5rem]"></p>
        </div>
        <div class="grid grid-cols-2 gap-3 mb-5 -mt-10 pb-10">
          <button class="border border-gray-400 rounded-lg h-[3rem] text-gray-500 hover:text-gray-400" onclick="openSheet()">
            Cancel
          </button>
          <button class="rounded-lg bg-[#3B42A2] h-[3rem] text-white hover:opacity-90" onclick="addBlog()">
            Create
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<%= render 'shared/bottom_sheet' %>

<script>
    $(document).ready(function () {
        const quill = new Quill('#editor', {
            modules: {
                table: true,
                syntax: true,
                toolbar: '#toolbar-container',
            },
            placeholder: 'Start Typing Here...',
            theme: 'snow',
        });

        var toolbarOptions = [
            ['table']
        ];
        var tableButton = document.querySelector('.ql-table');
        tableButton.addEventListener('click', function() {
            var table = prompt("Enter rows and columns separated by 'x' (e.g., '2x3' for 2 rows and 3 columns):");
            if (table) {
                var [rows, columns] = table.split('x').map(Number);
                if (!isNaN(rows) && !isNaN(columns) && rows > 0 && columns > 0) {
                    insertTable(rows, columns);
                } else {
                    alert("Invalid input. Please enter valid numbers for rows and columns.");
                }
            }
        });

        function insertTable(rows, columns) {
            var tableHtml = '<table>';
            for (var i = 0; i < rows; i++) {
                tableHtml += '<tr>';
                for (var j = 0; j < columns; j++) {
                    tableHtml += '<td><br></td>';
                }
                tableHtml += '</tr>';
            }
            tableHtml += '</table>';
            var range = quill.getSelection();
            if (range) {
                quill.clipboard.dangerouslyPasteHTML(range.index + 1, tableHtml);
            } else {
                quill.clipboard.dangerouslyPasteHTML(tableHtml);
            }
            quill.setSelection(range.index);
        }
    })
    function categories() {
        var value = document.getElementById('input_categories').value
        var categoriesError = document.getElementById('categories_error')
        var close_img = document.getElementById('remove-categories-img')

        var categoriesField = document.getElementById('categories');
        var categories_values = JSON.parse(categoriesField.value || '[]');
        if(categories_values.includes(value)) {
            categoriesError.innerText = `${value} already present`
            return
        }
        categoriesError.innerText = ""
        categories_values.push(value.split(' ').join('_'));
        categoriesField.value = JSON.stringify(categories_values);
        document.getElementById('input_categories').value = ""
        var mainDiv = document.getElementById('categories_show')
        var categoriesDiv = document.createElement('div')
        categoriesDiv.setAttribute('class', 'inline-block')
        categoriesDiv.setAttribute('id', `${value.split(' ').join('_')}`)

        var categoriesInnerDiv = document.createElement('div')
        categoriesInnerDiv.setAttribute('class', 'flex flex-row bg-[#3FB7CB] rounded-lg p-2 ml-2 mt-2')

        var p = document.createElement('p')
        p.innerText = value
        p.setAttribute('class', 'text-white')
        p.setAttribute('name', 'categories[]')

        var img = document.createElement('img')
        img.src = close_img.src
        img.setAttribute('class', 'w-5 h-5 pt-1 cursor-pointer mt-[2px]')
        img.setAttribute('onclick', `delete_categories(${value.split(' ').join('_')})`)

        categoriesInnerDiv.append(p)
        categoriesInnerDiv.append(img)
        categoriesDiv.append(categoriesInnerDiv)
        mainDiv.append(categoriesDiv)
        document.getElementById('add_button').style.display = 'none'
    }

    function delete_categories(value) {
        var element = document.getElementById(value.id)
        element.remove()
        var categoriesField = document.getElementById('categories');
        var categories_values = JSON.parse(categoriesField.value || '[]');
        var index = categories_values.indexOf(element.innerText.trim());
        if (index !== -1) {
            categories_values.splice(index, 1);
            categoriesField.value = JSON.stringify(categories_values);
        }
    }

    function show_add_button(input) {
        if (input.value !== "") {
            document.getElementById('add_button').style.display = 'block'
        } else {
            document.getElementById('add_button').style.display = 'none'
        }
    }

    function openSheet() {
        const bottomSheet = document.getElementById('bottomSheet');
        bottomSheet.style.bottom = '0';
    }

    function closeBottom() {
        const bottomSheet = document.getElementById('bottomSheet');
        bottomSheet.style.bottom = '-100%';
    }

    function createDataTransfer(imagesData) {
        var dataTransfer = new DataTransfer();
        imagesData.forEach(function(data, index) {
            var file = new File([data], 'image_' + index + '.jpeg', { type: 'image/jpeg' });
            dataTransfer.items.add(file);
        });

        return dataTransfer;
    }


    async function addBlog() {
        if (check_validations()) {
            var title = document.getElementById('title').value
            var categories = document.getElementById('categories').value
            var editor = document.getElementById('editor');
            var formData = new FormData();
            var imagesArray = [];
            var imgTags = editor.childNodes[0].querySelectorAll('img')
            if (imgTags) {
                await Promise.all(Array.from(imgTags).map(async function(img) {
                    try {
                        const res = await fetch(img.src);
                        const blob = await res.blob();
                        const file = new File([blob], 'dot.png', { type: blob.type });
                        imagesArray.push(file);
                    } catch (error) {
                        console.error('Error fetching image:', error);
                    }
                }));
                var dataTransfer = createDataTransfer(imagesArray);
                for (var i = 0; i < dataTransfer.files.length; i++) {
                    formData.append('details_images[]', dataTransfer.files[i]);
                }
            }
            var csrfToken = $('meta[name="csrf-token"]').attr('content');
            formData.append('authenticity_token', csrfToken);
            formData.append('title', title);
            formData.append('categories', categories);
            await sendFormData(formData, imgTags, editor)
        }
    }

    async function sendFormData(formData, imgTage, editor) {
        $.ajax({
            url: '/blogs',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: async function (res) {
                debugger
                for(var i=0; i < imgTage.length; i++) {
                    debugger
                    imgTage[i].src = res?.images_urls[i]
                }
                await updateBlog(editor, res?.blog_id)
            }
        })
    }

    async function updateBlog(editor, blog_id) {
        var csrfToken = $('meta[name="csrf-token"]').attr('content');
        var formData = new FormData();
        formData.append('description', $('#editor .ql-editor').html());
        formData.append('id', blog_id)
        formData.append('authenticity_token', csrfToken);
        $.ajax({
            url: '/blogs/blog_details',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (res) {
                debugger
            }
        })
    }

    function check_validations() {
        var inputFields = [
            { id: `#title`, label: `#title_error`, message: "Title can't be blank" },
            { id: `#categories`, label: `#categories_error`, message: 'There must be at least one category' },
            { id: `#editor`, label: `#details-error`, message: "Details can't be blank" },
        ];

        var isValid = true;

        for (var i = 0; i < inputFields.length; i++) {
            var field = $(inputFields[i].id)[0]
            var errorElement = $(inputFields[i].label)[0];
            if (inputFields[i].id === '#editor' && field.childNodes[0].childNodes[0].innerText === '\n'){
                errorElement.innerText = inputFields[i].message;
                isValid = false;
            } else {
                if (field.value === "") {
                    errorElement.innerText = inputFields[i].message;
                    isValid = false;
                } else {
                    errorElement.innerText = '';
                }
            }
        }

        return isValid;
    }
</script>
