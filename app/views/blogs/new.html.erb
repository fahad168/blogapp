<%= render 'shared/header' %>
<div class="px-20 mt-5 mb-10">
  <img src="<%= asset_path('close.svg') %>" id="remove-categories-img" class="hidden">
  <div class="bg-white rounded-xl shadow-xl h-auto">
    <p class="font-bold robo-font text-[2.5rem] pt-5 text-black text-center">Add Blog</p>
    <div class="grid grid-col-2 gap-4 px-60 pt-20">
      <div class="flex flex-col justify-start">
        <label class="text-xl font-semibold">Title:</label>
        <input id="title" class="border border-[grey] w-auto p-3 rounded-xl mt-2 focus:ring-[#3B42A2] focus:border-2 focus:border-[#3B42A2] focus:outline-none" placeholder="Enter Your Title Here...">
        <p id="title_error" class="text-[red] text-lg"></p>
      </div>
      <div class="flex flex-col justify-start mt-5">
        <div>
          <div class="flex flex-col">
            <label class="text-xl font-semibold ">Categories:</label>
            <div id="categories_show" class="pb-3">
              <%# @categories&.each do |categories| %>
<!--                <div class="inline-block" id='<%#= "categories-" + categories.id.to_s %>'>-->
<!--                  <div class="flex flex-row bg-[#3FB7CB] rounded-lg p-2 ml-2 mt-2">-->
<!--                    <p class="text-white"><%#= categories.title.split('_').join(' ') %></p>-->
                    <%#= image_tag "trash.svg", class: "w-5 h-5 pt-1 cursor-pointer", onclick: "delete_categories('categories-#{categories.id}')" %>
<!--                  </div>-->
<!--                </div>-->
              <%# end %>
            </div>
            <input id="categories" name="categories" class="hidden">
            <div class="flex flex-row justify-start bg-gray-50 border border-[grey] text-gray-900 text-base rounded-lg outline-none block w-full py-3 px-3">
