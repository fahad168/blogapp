<%= render "my_blogs/confirmation_drawer" %>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const myBlogsDiv = document.querySelector("#my_blogs_div");
        myBlogsDiv.addEventListener("click", function (event) {
            const paginationLink = event.target.closest(".pagination a");
            if (paginationLink) {
                event.preventDefault();
                const page = paginationLink.getAttribute("href").split('?')[1].split('=')[1]
                const url = `/my_blogs?page=${page}`
                ajaxCall(url, myBlogsDiv)
            }
        });
    });

    function getQueryRecord(value) {
        const myBlogsDiv = document.querySelector("#my_blogs_div");
        const url = `/my_blogs?query=${value}`
        ajaxCall(url, myBlogsDiv)
    }

    function ajaxCall(url, myBlogsDiv) {
        $.ajax({
            url: url,
            type: "GET",
            success: function (res) {
                myBlogsDiv.innerHTML = res.entries;
            },
            error: function (xhr, status, error) {
                console.error("Error loading page:", error);
            },
        });
    }
</script>