        <%#= form_with(url: '/my_blogs/bulk_delete', method: :get, html: { class: 'inline-flex' }) do |f| %>
          <input class="hidden" id="blog_ids">
          <button
            data-drawer-target="drawer-top-delete" data-drawer-show="drawer-top-delete" data-drawer-placement="top" aria-controls="drawer-top-delete"
            type="button"
            class="hidden ml-2 inline-flex items-center px-4 py-2 bg-red-600 transition ease-in-out delay-75 hover:bg-red-700 text-white text-md font-medium rounded-md hover:-translate-y-1 hover:scale-110"
            id="deleteButton"
          >
            <svg
              stroke="currentColor"
              viewBox="0 0 24 24"
              fill="none"
              class="h-5 w-5 mr-2"
              xmlns="http://www.w3.org/2000/svg"
            >
