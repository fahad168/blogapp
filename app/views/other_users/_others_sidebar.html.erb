<div class="-mx-1">
  <ul class="flex flex-row justify-center w-full flex-wrap items-center h-10">
    <li class="block relative">
      <a href="/other_user_profile?id=<%= params[:id] %>" class="flex items-center h-10 leading-10 px-7 rounded cursor-pointer no-underline hover:no-underline transition-colors duration-100 mx-1 hover:bg-white hover:text-black <%= params[:action] == 'other_user_profile' ? 'bg-white text-black' : 'text-white' %>">
        <span class="text-center">Account</span>
      </a>
    </li>
    <li class="block relative">
      <a href="/other_user_albums?id=<%= params[:id] %>" class="flex items-center h-10 leading-10 px-7 rounded cursor-pointer no-underline hover:no-underline transition-colors duration-100 mx-1 hover:bg-white hover:text-black <%= params[:action] == 'other_user_albums' ? 'bg-white text-black' : 'text-white' %>">
        <span>Albums</span>
      </a>
    </li>
    <li class="block relative">
      <a href="/other_user_followers?id=<%= params[:id] %>" class="flex items-center h-10 leading-10 px-7 rounded cursor-pointer no-underline hover:no-underline transition-colors duration-100 mx-1 hover:bg-white hover:text-black <%= params[:action] == 'other_user_followers' ? 'bg-white text-black' : 'text-white' %>">
        <span>Followers</span>
      </a>
    </li>
    <li class="block relative">
      <a href="/other_user_followings?id=<%= params[:id] %>" class="flex items-center h-10 leading-10 px-7 rounded cursor-pointer no-underline hover:no-underline transition-colors duration-100 mx-1 hover:bg-white hover:text-black <%= params[:action] == 'other_user_followings' ? 'bg-white text-black' : 'text-white' %>">
        <span>Followings</span>
      </a>
    </li>
  </ul>
  <div class="absolute -mt-10">
    <% if current_user.followings.pluck(:following_id).include?(params[:id].to_i) %>
      <% if current_user.followings.find_by(following_id: params[:id]).status == 'Pending' %>
        <button type="button" id="button<%= params[:id] %>" class="btn relative px-8 w-[8rem] h-[2.5rem] text-white text-base font-bold uppercase rounded-lg overflow-hidden bg-transparent border-2 border-[white] transition-all duration-400 ease-in-out shadow-md hover:scale-105 hover:text-white hover:shadow-lg active:scale-90 before:absolute before:top-0 before:-left-full before:w-full before:h-full hover:border-0 before:bg-gradient-to-r before:from-red-900 before:to-red-800 before:transition-all before:duration-500 before:ease-in-out before:z-[-1] before:rounded-lg hover:before:left-0" onclick="cancel_following('<%= params[:id] %>')">
          <span class="btn-text-one">Requested</span>
          <span class="btn-text-two">Cancel</span>
        </button>
      <% elsif current_user.followings.find_by(following_id: params[:id]).status == 'Rejected' %>
        <button type="button" id="button<%= params[:id] %>" class="relative py-2 px-8 text-black text-base font-bold uppercase rounded-lg overflow-hidden bg-white transition-all duration-400 ease-in-out shadow-md hover:scale-105 hover:text-white hover:shadow-lg active:scale-90 before:absolute before:top-0 before:-left-full before:w-full before:h-full before:bg-gradient-to-r before:from-blue-500 before:to-blue-400 before:transition-all before:duration-500 before:ease-in-out before:z-[-1] before:rounded-lg hover:before:left-0" onclick="create_following('<%= params[:id] %>')">
          Follow
        </button>
      <% else %>
        <div id="button<%= params[:id] %>" class="relative py-2 px-8 text-black text-base font-bold uppercase rounded-lg overflow-hidden bg-white transition-all duration-400 ease-in-out shadow-md hover:scale-105 hover:text-white hover:shadow-lg active:scale-90 before:absolute before:top-0 before:-left-full before:w-full before:h-full before:bg-gradient-to-r before:from-blue-500 before:to-blue-400 before:transition-all before:duration-500 before:ease-in-out before:z-[-1] before:rounded-lg hover:before:left-0 cursor-pointer">
          Friends
        </div>
      <% end %>
    <% else %>
      <button type="button" id="button<%= params[:id] %>" class="relative py-2 px-8 text-black text-base font-bold uppercase rounded-lg overflow-hidden bg-white transition-all duration-400 ease-in-out shadow-md hover:scale-105 hover:text-white hover:shadow-lg active:scale-90 before:absolute before:top-0 before:-left-full before:w-full before:h-full before:bg-gradient-to-r before:from-blue-500 before:to-blue-400 before:transition-all before:duration-500 before:ease-in-out before:z-[-1] before:rounded-lg hover:before:left-0" onclick="create_following('<%= params[:id] %>')">
        Follow
      </button>
    <% end %>
  </div>
</div>
<%= javascript_include_tag('home/profile') %>
