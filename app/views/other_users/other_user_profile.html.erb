<main class="max-w-[1920px] mx-auto relative h-screen container" id="indexFile" data-controller="modal-data">
  <%= render "shared/header" %>
  <div class="relative">
    <%= render 'other_users/other_top_profile' %>
  </div>
  <div class="min-w-screen min-h-[30rem] bg-transparent px-5 pb-5 pt-[15rem] flex flex-row justify-center">
    <div class="py-3 px-5 bg-transparent border-2 border-[gray] rounded shadow-xl w-[80%]">
      <%= render 'other_users/others_sidebar' %>
      <div class="mt-[5rem] mb-[5rem] flex flex-row">
        <div class="flex flex-col justify-center w-full ml-[12rem]">
          <div class="grid grid-cols-2 w-[50%] mx-auto gap-5" style="justify-items: start">
            <label class="text-gray-500">Username:</label>
            <p class="text-white"><%= @user.username %></p>
          </div>
          <div class="grid grid-cols-2 w-[50%] gap-5 mx-auto mt-5" style="justify-items: start">
            <label class="text-gray-500">Email:</label>
            <p class="text-white text-center"><%= @user.email %></p>
          </div>
          <div class="grid grid-cols-2 w-[50%] gap-5 mx-auto mt-5" style="justify-items: start">
            <label class="text-gray-500">Followers:</label>
            <p class="text-white text-center"><%= @user.followers.where(status: 1).count %></p>
          </div>
          <div class="grid grid-cols-2 w-[50%] gap-5 mx-auto mt-5" style="justify-items: start">
            <label class="text-gray-500">Followings:</label>
            <p class="text-white text-center"><%= @user.followings.where(status: 1).count %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
