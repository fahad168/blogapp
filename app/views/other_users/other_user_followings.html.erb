<main class="max-w-[1920px] mx-auto relative h-screen container" id="indexFile" data-controller="modal-data">
  <%= render "shared/header" %>
  <div class="relative">
    <%= render 'other_users/other_top_profile' %>
  </div>
  <div class="min-w-screen min-h-[30rem] bg-transparent px-5 pb-5 pt-[15rem] flex flex-row justify-center">
    <div class="py-3 px-5 bg-transparent border-2 border-[gray] rounded shadow-xl w-[80%]">
      <%= render 'other_users/others_sidebar' %>
      <div class="mt-[2rem] mb-[2rem] ml-[3.5rem]">
        <div class="flex flex-col pt-10 w-[80%] ml-[6rem]" id="item-list">
          <% if @followers.present? %>
            <% @followers.each_with_index do |follower, index| %>
              <% user = User.find_by(id: following.following_id) %>
              <div class="bg-[#494F55] shadow-[0_0_4px_0_rgba(0,0,0,0.25)] rounded-lg flex flex-row justify-between searchable-item mb-10 p-4">
                <div class="flex flex-row justify-start">
                  <img class="w-10 h-10 rounded-full object-cover <%= user.profile_image.attached? ? '' : 'border-2 border-[grey]' %>" src="<%= user.profile_image.attached? ? user.profile_image.blob.url : asset_path('user.svg') %>" loading="lazy" alt="profile image">
                  <a href="/other_user_profile?id=<%= user.id %>" class="text-center text-white ml-5 hover:underline cursor-pointer mt-2"><%= user.username %></a>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="flex flex-col">
              <% if @user.setting.private_account %>
                <p class="text-[red] text-center">Account is private. Follow to see!!!</p>
              <% else %>
                <p class="text-[red] text-center">No followings present</p>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</main>
