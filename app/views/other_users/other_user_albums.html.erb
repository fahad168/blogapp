<main class="max-w-[1920px] mx-auto relative h-screen container" id="indexFile" data-controller="modal-data">
  <%= render "shared/header" %>
  <div class="relative">
    <%= render 'other_users/other_top_profile' %>
  </div>
  <div class="min-w-screen min-h-[30rem] bg-transparent px-5 pb-5 pt-[15rem] flex flex-row justify-center">
    <div class="py-3 px-5 bg-transparent border-2 border-[gray] rounded shadow-xl w-[80%]">
      <%= render 'other_users/others_sidebar' %>
      <div class="flex flex-row flex-wrap mt-[2rem]">
        <% if @other_albums.present? && !@user.setting.private_albums %>
          <% @other_albums.each do |album| %>
            <% if album.private == false %>
              <div class="album_card ml-[3rem]">
                <div class="top-section">
                  <div class="border">
                  </div>
                  <div class="w-full h-full" onclick="show_album('<%= album.id %>')">
                    <img src="<%= album.album_image.attached? ? album.album_image.blob.url : asset_path('no_image_found.png') %>" loading="lazy" class="rounded-lg h-[9rem] absolute w-full mt-1 cursor-pointer" alt="album image">
                  </div>
                  <div class="icons">
                    <div class="logo">
                      <%= album.title.split(' ').first.capitalize %>
                    </div>
                    <div class="social-media">
                      <a href="https://web.whatsapp.com/send?text=<%= CGI.escape(album.shareable_link) %>" data-action="share/whatsapp/share" class="text-white" target="_blank"><img src="<%= asset_path('whatsapp.svg') %>" class="w-[0.8rem] hover:opacity-75" alt="whatsapp"></a>
                      <a href="https://twitter.com/intent/tweet?url=<%= CGI.escape(album.shareable_link) %>&text=<%= album.title.capitalize %>%20by%20<%= current_user.username.capitalize %>&media=https%3A%2F%2Fimage.tmdb.org%2Ft%2Fp%2Fw780%2F<%= album.album_contents.present? ? album.album_contents.first.img_url : '' %>" class="text-white" target="_blank"><img src="<%= asset_path('twitter.svg') %>" class="w-[0.8rem] hover:opacity-75" alt="twitter"></a>
                      <a href="https://www.facebook.com/sharer.php?u=<%= CGI.escape(album.shareable_link) %>" class="text-white" target="_blank"><img src="<%= asset_path('facebook.svg') %>" class="w-[0.8rem] hover:opacity-75" alt="facebook"></a>
                    </div>
                  </div>
                </div>
                <div class="bottom-section">
                  <div class="flex flex-row justify-between">
                    <span class="title cursor-pointer hover:underline" onclick="show_album('<%= album.id %>')"><%= album.title.capitalize %></span>
                  </div>
                  <div class="row row1">
                    <div class="item">
                      <span class="big-text"><%= album.album_contents.count %></span>
                      <span class="regular-text">Total Movies</span>
                    </div>
                    <div class="item">
                      <span class="big-text"><%= album.total_views %></span>
                      <span class="regular-text">Total View</span>
                    </div>
                    <div class="item">
                      <span class="big-text"><%= album.shared_count %></span>
                      <span class="regular-text">Shared Count</span>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <div class="flex flex-row justify-center w-full mt-[2rem]">
            <% if @user.setting.private_account %>
              <p class="text-[red] text-center">Account is private. Follow to see!!!</p>
            <% else %>
              <p class="text-[red] text-center">No albums present</p>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
    <%= render 'profile/show_album_modal' %>
    <%= render 'home/movie_modal' %>
    <%= render 'home/season_modal' %>
  </div>
</main>
<%= javascript_include_tag('home/show_album') %>
<%= javascript_include_tag('home/home_modal') %>
