<main class="max-w-[1920px] mx-auto relative h-screen container" id="indexFile" data-controller="modal-data">
  <%= render "shared/header" %>
  <div class="single-item -mt-[88px]">
    <%= render "home/background_images" %>
  </div>
  <% count = 0 %>
  <% @users&.each_with_index do |user| %>
    <% if user.albums.present? && user.setting.private_albums != true %>
      <div class="genre flex flex-col <%= if count == 0
                                            '-mb-[15rem] bottom-0 absolute'
                                          else
                                            count == 1 ? 'mt-[17rem]' : 'mt-[2rem]'
                                          end %> w-full">
        <div class="genre-content flex flex-row justify-between pl-8 pr-5 pb-5">
          <p class="genre-title font-bold text-3xl">Albums by <a href="/other_user_profile?id=<%= user.id %>" class="hover:underline"><%= user.username %></a></p>
        </div>
        <div class="flex flex-row overflow-x-auto">
          <% user.albums.each do |album| %>
            <% if album.private == false %>
              <a class="card ml-[1.875rem] cursor-pointer" onclick="show_album('<%= album.id %>')">
                <img src="<%= album.album_image.blob.url %>" loading="lazy" alt="Album Image" class="object-cover">
                <div class="descriptions flex flex-col justify-between">
                  <h1 class="truncate font-bold text-xl"><%= album.title.capitalize %></h1>
                  <!--                <p class="line-clamp-5"><%#= playing['overview'] %></p>-->
                  <div class="flex flex-row justify-between">
                    <div class="flex flex-row"><p class="text-[red] font-bold">Movies:</p>
                      <p class="ml-2 text-sm"><%= album.album_contents.count %></p>
                    </div>
                    <div class="flex flex-row"><p class="text-[red] font-bold">Views:</p>
                      <p class="ml-2 text-sm"><%= album.total_views %></p>
                    </div>
                    <div class="flex flex-row"><p class="text-[red] font-bold">Shared:</p>
                      <p class="ml-2 text-sm"><%= album.shared_count %></p>
                    </div>
                  </div>
                </div>
              </a>
            <% end %>
          <% end %>
        </div>
      </div>
      <% count += 1 %>
    <% end %>
  <% end %>
  <%= render 'profile/show_album_modal' %>
  <%= render 'home/movie_modal' %>
  <%= render 'home/season_modal' %>
</main>

<%= javascript_include_tag('home/show_album') %>
<%= javascript_include_tag('home/home_modal') %>
<%= javascript_include_tag('slick') %>

<script>
  $(document).ready(function () {
      $('.single-item').slick({
          autoplay: true,
          autoplaySpeed: 2000,
          arrows: false
      })
  })
</script>
