<div class="flex justify-between">
  <div class="min-h-screen">
    <%= image_tag('background_image1.jpeg', class: 'w-full h-full object-cover', style: "border-top-right-radius: 3rem; border-bottom-right-radius: 3rem") %>
  </div>

  <div class="flex flex-col p-[10rem]">
    <h1 class="text-white text-3xl text-center mb-3 font-bold">Welcome To MovieCorn</h1>
    <h1 class="text-white text-xl text-center mb-10 font-bold">Enter Your Details To Sign Up</h1>
    <%= form_for(resource, as: resource_name, url: new_user_registration_path, data: { turbo: false }) do |f| %>
      <div class="flex flex-col justify-content-center items-center w-full">
        <div class="mb-4 w-[25rem]">
          <%= f.label :username, class: 'block text-white text-sm font-bold mb-2' %>
          <%= f.text_field 'username', class: 'shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline text-black', placeholder: 'e.g Alex' %>
        </div>

        <div class="mb-4 w-[25rem]">
          <%= f.label :email, class: 'block text-white text-sm font-bold mb-2' %>
          <%= f.email_field 'email', class: 'shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline text-black', placeholder: 'abc@example.com' %>
        </div>

        <div class="mb-4 w-[25rem]">
          <%= f.label :password, class: 'block text-white text-sm font-bold mb-2' %>
          <%= f.password_field 'password', class: 'shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline text-black', placeholder: '*******' %>
        </div>

        <div class="mb-4 w-[25rem]">
          <%= f.label :password_confirmation, class: 'block text-white text-sm font-bold mb-2' %>
          <%= f.password_field 'password_confirmation', class: 'shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline text-black', placeholder: '*******' %>
        </div>

        <%= f.submit 'Sign Up', class: 'bg-red-500 hover:bg-red-400 cursor-pointer text-white font-bold py-2 mt-3 px-4 rounded focus:outline-none focus:shadow-outline w-[25rem]' %>
      </div>
    <% end %>
    <div class="flex flex-row mt-[5rem]">
      <div class="border-t-2 border-white w-[11.3rem]"></div>
      <p class="p-2 position-absolute -mt-5">OR</p>
      <div class="border-t-2 border-white w-[11.3rem]"></div>
    </div>
    <div class="flex flex-col mt-5">
      <%= button_to user_google_oauth2_omniauth_authorize_path, method: :post, class: 'w-[25rem] bg-[white] flex flex-rows justify-center rounded-lg text-center', data: {turbo: "false"} do %>
        <%= image_tag('google.svg', class: 'w-12 h-12') %>
        <p class="text-[black] mt-[0.6rem]">Sign Up With Google</p>
      <% end %>
    </div>
    <div class="mt-[4rem] text-center">
      <p>Already Have Account <a href="/users/sign_in" class="underline text-[red]">Sign In</a></p>
    </div>
  </div>
</div>
