<% content_for :meta_tags do %>
  <meta name="description" content="Browse all type of movies and tv shows using language, sort_by, year, genre">
  <meta name="keywords" content="seasons, genres, explore, search, tv_shows, episodes, movies, browse, search">
<% end %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/chosen/1.8.7/chosen.jquery.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/chosen/1.8.7/chosen.min.css" integrity="sha512-yVvxUQV0QESBt1SyZbNJMAwyKvFTLMyXSyBHDO4BG5t7k/Lw34tyqlSDlKIrIENIzCl+RVUNjmCPG+V/GMesRw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

<main class="max-w-[1920px] mx-auto relative h-screen container" id="indexFile" data-controller="search-scroll" data-action="scroll@window->search-scroll#get_more_search_data">
  <%= render "shared/header" %>
  <div class="flex flex-row justify-start mt-[8rem] ml-10">
    <div class="flex flex-col justify-start ml-5">
      <label for="advance_search" class="text-white text-sm mb-2">Select Type</label>
      <select id="advance_search" class="chosen-select search_type" name="type" onchange="show_genre(this)">
        <option disabled selected>Select Type</option>
        <option value="movie">Movies</option>
        <option value="tv">Tv Shows</option>
      </select>
    </div>
    <div class="flex-col justify-start ml-5" id="movie_genre" style="display: none">
      <label for="advance_search" class="text-white text-sm mb-2">Movie Genre</label>
      <select id="advance_search" name="movie_genre" class="chosen-select movie_genre" onchange="ajax_cal(this.value)">
        <option disabled selected>Select Movie Genre</option>
        <%= Genre.all.each do |genre| %>
          <option value="<%= genre.genre_id %>"><%= genre.genre_name %></option>
        <% end %>
      </select>
    </div>
    <div class="flex-col justify-start ml-5" id="tv_genre" style="display: none">
      <label for="advance_search" class="text-white text-sm mb-2">Tv Genre</label>
      <select id="advance_search" name="album_genre" class="chosen-select tv_genre" onchange="ajax_cal(this.value)">
        <option disabled selected>Select Tv Genre</option>
        <%= TvGenre.all.each do |genre| %>
          <option value="<%= genre.genre_id %>"><%= genre.genre_name %></option>
        <% end %>
      </select>
    </div>
    <div class="flex flex-col justify-start ml-5">
      <label for="advance_search" class="text-white text-sm mb-2">Language</label>
      <select id="advance_search" name="language" class="chosen-select language" onchange="ajax_cal(this.value)">
        <option disabled selected>Select Language</option>
        <% Language.all.each do |language| %>
          <option class="text-black" <%= params[:language].present? && params[:language] == language.iso_name ? 'selected' : '' %> value="<%= language.iso_name %>"><%= language.english_name %></option>
        <% end %>
      </select>
    </div>
    <div class="flex flex-col justify-start ml-5">
      <label for="advance_search" class="text-white text-sm mb-2">Year</label>
      <select id="advance_search" class="chosen-select year" name="year" onchange="ajax_cal(this.value)">
        <option disabled selected>Choose year</option>
        <% (1980..2030).each do |year| %>
          <option <%= params[:year].present? && params[:year] == year ? 'selected' : '' %> value="<%= year %>"><%= year %></option>
        <% end %>
      </select>
    </div>
    <div class="flex flex-col justify-start ml-5">
      <label for="advance_search" class="text-white text-sm mb-2">Sort By</label>
      <select id="advance_search" class="chosen-select sort_by" name="sort_by" onchange="ajax_cal(this.value)">
        <option disabled selected>Sort</option>
        <option value="popularity.asc">popularity.asc</option>
        <option value="popularity.desc">popularity.desc</option>
        <option value="revenue.asc">revenue.asc</option>
        <option value="revenue.desc">revenue.desc</option>
        <option value="primary_release_date.asc">primary_release_date.asc</option>
        <option value="primary_release_date.desc">primary_release_date.desc</option>
        <option value="vote_average.asc">vote_average.asc</option>
        <option value="vote_average.desc">vote_average.desc</option>
        <option value="vote_count.asc">vote_count.asc</option>
        <option value="vote_count.desc">vote_count.desc</option>
      </select>
    </div>
  </div>
  <div class="flex flex-row flex-wrap justify-evenly mt-10 mb-10 mr-5" id="advance_search_data">
    <% if @combined_data != [] %>
      <% @combined_data.each do |playing| %>
        <% if playing['original_title'].present? %>
          <%= render 'home/card', playing: playing, page: 'mt-5' %>
        <% else %>
          <%= render 'home/tv_card', playing: playing, page: 'mt-5' %>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <%= render 'home/movie_modal' %>
  <%= render 'home/season_modal' %>
  <%= render "home/movie_play_modal" %>
  <%= render "tv_shows/watch_season_episodes" %>
</main>
<%= javascript_include_tag('home/home_modal') %>

<script>
  $(document).ready(function () {
      localStorage.setItem('index_page', '1')
      localStorage.setItem('filter_page', '1')
      localStorage.setItem('scroll_filter_page', '1')
  })
  $('.chosen-select').chosen({
      disable_search_threshold: 15,
      no_results_text: 'No results found',
  });

  function show_genre(dropdown) {
      if (dropdown.value === 'movie') {
          document.getElementById('movie_genre').style.display = "flex"
          document.getElementById('tv_genre').style.display = "none"
      }else if(dropdown.value === 'tv' ) {
          document.getElementById('movie_genre').style.display = "none"
          document.getElementById('tv_genre').style.display = "flex"
      }
      ajax_cal()
  }

  function ajax_cal() {
      if ($('.search_type')[0].value !== 'Select Type') {
          var loader = document.getElementById('loader-container1')
          loader.style.display = "flex"
          localStorage.setItem('index_page', '1')
          localStorage.setItem('search_page', '1')
          localStorage.setItem('scroll_filter_page', '1')
          let url = `/browse?type=${$('.search_type')[0].value}`
          var movie_genre = $('.movie_genre')[0].value
          var tv_genre = $('.tv_genre')[0].value
          var language = $('.language')[0].value
          var year = $('.year')[0].value
          var sort_by = $('.sort_by')[0].value
          if (movie_genre !== 'Select Movie Genre' ) {
              url = `${url}&genre_id=${movie_genre}`
          }
          if (tv_genre !== 'Select Tv Genre' ) {
              url = `${url}&genre_id=${tv_genre}`
          }
          if (language !== 'Select Language' ) {
              url = `${url}&language=${language}`
          }
          if (year !== 'Choose year') {
              url = `${url}&year=${year}`
          }
          if (sort_by !== 'Sort' ) {
              url = `${url}&sort_by=${sort_by}`
          }
          $.ajax({
              type: 'GET',
              url: url,
              success: function (res) {
                  $('#advance_search_data').html(res.entries)
                  loader.style.display = "none"
              }
          })
      }
  }
</script>
