<script>
  function showCartButton(i) {
      var cartBtn = document.getElementById(`cartBtn${i}`)
      cartBtn.classList.remove('leave')
      cartBtn.classList.add('enter')
      cartBtn.classList.remove('hidden')
  }

  function hideCartButton(i) {
      var cartBtn = document.getElementById(`cartBtn${i}`);
      cartBtn.classList.remove('enter');
      cartBtn.classList.add('leave');
      setTimeout(function () {
          cartBtn.classList.remove('leave');
          cartBtn.classList.add('hidden');
      }, 500);
      setTimeout(function () {
          cartBtn.classList.add('hidden');
      }, 400);
  }
</script>
