<% @blogs&.each_with_index do |blog, index| %>
  <div class="w-full h-[30rem] object-cover rounded-lg flex flex-row justify-center <%= index > 0 ? 'mt-80' : '' %>">
    <div role="status" class="w-full h-full flex items-center justify-center bg-gray-300 rounded-xl animate-pulse dark:bg-gray-700" id="skeletonLoaderBlog_<%= blog.id %>">
      <svg class="w-10 h-10 text-gray-200 dark:text-gray-600" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 20">
        <path d="M5 5V.13a2.96 2.96 0 0 0-1.293.749L.879 3.707A2.98 2.98 0 0 0 .13 5H5Z"/>
        <path d="M14.066 0H7v5a2 2 0 0 1-2 2H0v11a1.97 1.97 0 0 0 1.934 2h12.132A1.97 1.97 0 0 0 16 18V2a1.97 1.97 0 0 0-1.934-2ZM9 13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2Zm4 .382a1 1 0 0 1-1.447.894L10 13v-2l1.553-1.276a1 1 0 0 1 1.447.894v2.764Z"/>
      </svg>
      <span class="sr-only">Loading...</span>
    </div>
    <img id="blog_<%= blog.id %>" src="<%= blog.thumbnail.blob.url %>" class="w-full h-full object-cover rounded-xl hidden" style="background-repeat: no-repeat; background-position: center" loading="lazy" onload="display_image('<%= blog.id %>')">
    <!--            <div style="background-image: url(<%#= blog.thumbnail.blob.url %>); background-repeat: no-repeat; object-fit: cover" class="w-full h-full object-cover rounded-lg flex flex-row justify-center">-->

    <!--            </div>-->
    <div class="bg-white md:w-[40%] h-[20rem] mt-[25rem] rounded-lg shadow-2xl p-10 absolute">
        <p class="text-[#8C98A2] font-normal text-md">
          <%= JSON.parse(blog.categories).first(2).map! { |category| category.split('_').join(' ').capitalize }.join(', ') %> - <%= blog.created_at.strftime('%b %d, %Y') %>
        </p>
        <p class="font-bold mt-3 text-2xl line-clamp-2 text-[#1E215A]"><%= blog.title.capitalize %></p>
        <p class="font-medium mt-4 text-md line-clamp-4 text-[#7E8A96]"><%= blog.description %></p>
        <button class="cta mt-5" onclick="window.location.href = '/blogs/<%= blog.title.split(' ').join('-').downcase %>'">
          <span class="italic">Read more</span>
          <svg width="15px" height="10px" viewBox="0 0 13 10">
            <path d="M1,5 L11,5"></path>
            <polyline points="8 1 12 5 8 9"></polyline>
          </svg>
        </button>
    </div>
  </div>
<% end %>
<div class="mt-[18rem] w-[35%]">
  <%= will_paginate(@blogs, inner_window: 2, outer_window: -1) %>
</div>

<script>
  function display_image(id) {
      document.getElementById(`skeletonLoaderBlog_${id}`).style.display = "none"
      document.getElementById(`blog_${id}`).classList.remove('hidden')
  }
</script>
