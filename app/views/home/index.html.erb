<main class="max-w-[1920px] mx-auto relative h-screen container" id="indexFile" data-controller="modal-data">
  <%= render "shared/header" %>
  <div class="single-item -mt-[88px]">
    <% @trending_all['results']&.each_with_index do |trending, index| %>
      <div class="relative h-screen">
        <div class="absolute flex flex-col justify-center md:ml-[5rem] ml-10 w-[80%]" style="height: 80vh" id="popular_movies_responsive">
          <h1 class="texting lg:text-[6.25rem] md:text-[3rem] text-[2rem] w-full focus:outline-none line-clamp-1" id="texting" contenteditable data-heading="<%= trending['original_title'] %>">
            <% if trending['media_type'] == 'movie' %>
              <%= trending['original_title'] %>
            <% elsif trending['media_type'] == 'tv' %>
              <%= trending['name'] %>
            <% end %>
          </h1>
        </div>
        <div class="flex flex-col justify-center absolute lg:mt-5 mt-0 lg:ml-[5rem] ml-10 h-screen" id="popular_play_responsive">
          <% if trending['media_type'] == 'movie' %>
            <div class="flex flex-row">
              <button class="play mr-5" onclick="open_movie('<%= trending['id'] %>')">
                <svg viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="26px">
                  <path d="M424.4 214.7L72.4 6.6C43.8-10.3 0 6.1 0 47.9V464c0 37.5 40.7 60.1 72.4 41.3l352-208c31.4-18.5 31.5-64.1 0-82.6z" fill="currentColor"></path>
                </svg>
              </button>
              <button class="btn_details mr-3" data-controller="modal-data" data-action="click->modal-data#get_movie_data" data-movie-id="<%= trending['id'] %>">View
                Details
              </button>
            </div>
          <% elsif trending['media_type'] == 'tv' %>
            <div class="flex flex-row">
              <button class="play mr-5" onclick="openModal('<%= trending['id'] %>', '1', '1')">
                <svg viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="26px">
                  <path d="M424.4 214.7L72.4 6.6C43.8-10.3 0 6.1 0 47.9V464c0 37.5 40.7 60.1 72.4 41.3l352-208c31.4-18.5 31.5-64.1 0-82.6z" fill="currentColor"></path>
                </svg>
              </button>
              <button class="btn_details mr-3" data-controller="modal-data" data-action="click->modal-data#get_season_data" data-season-id="<%= trending['id'] %>">View
                Details
              </button>
            </div>
          <% end %>
        </div>
        <% if trending['backdrop_path'].present? %>
          <img src="<%= ENV['TMBD_IMAGE_URL'] %>/original/<%= trending['backdrop_path'] %>" class="h-full w-full" id="popular_image">
        <% else %>
          <img src="<%= ENV['TMBD_IMAGE_URL'] %>/original/<%= trending['poster_path'] %>" class="h-full w-full" id="popular_image">
        <% end %>
        <div class="absolute inset-x-0 h-[25rem] bottom-0 bg-gradient-to-t from-black to-transparent"></div>
      </div>
    <% end %>
  </div>
  <div class="genre flex flex-col lg:-mb-[15rem] mb-[2rem] bottom-0 w-full absolute">
    <div class="genre-content flex flex-row justify-between pl-8 pb-5">
      <p class="genre-title font-bold text-3xl cursor-pointer">Now Playing In Cinemas</p>
      <a href="/view_all?key=playing_now" class="text-[red] place-self-center mr-6">View All</a>
    </div>
    <div class="flex flex-row overflow-x-auto">
      <% @playing_now['results']&.each do |playing| %>
        <%= render 'home/card', playing: playing, page: 'mt-0' %>
    <% end %>
    </div>
  </div>
  <div class="genre flex flex-col lg:mt-[17rem] mt-0 w-full">
    <div class="genre-content flex flex-row justify-between pl-8 pb-5">
      <p class="genre-title font-bold text-3xl">Popular Movies</p>
      <a href="/view_all?key=popular_movies" class="text-[red] place-self-center mr-6">View All</a>
    </div>
    <div class="flex flex-row overflow-x-auto">
      <% @popular['results']&.each do |playing| %>
        <%= render 'home/card', playing: playing, page: 'mt-0' %>
      <% end %>
    </div>
  </div>
  <div class="genre flex flex-col mt-[2rem] w-full">
    <div class="genre-content flex flex-row justify-between pl-8 pb-5">
      <p class="genre-title font-bold text-3xl">Lollywood Movies</p>
      <a href="/view_all?key=lollywood&type=movies" class="text-[red] place-self-center mr-6">View All</a>
    </div>
    <div class="flex flex-row overflow-x-auto">
      <% @lollywood_movies['results']&.each do |playing| %>
        <%= render 'home/card', playing: playing, page: 'mt-0' %>
      <% end %>
    </div>
  </div>
  <div class="genre flex flex-col mt-[2rem] w-full">
    <div class="genre-content flex flex-row justify-between pl-8 pb-5">
      <p class="genre-title font-bold text-3xl">Bollywood Movies</p>
      <a href="/view_all?key=bollywood&type=movies" class="text-[red] place-self-center mr-6">View All</a>
    </div>
    <div class="flex flex-row overflow-x-auto">
      <% @bollywood_movies['results']&.each do |playing| %>
        <%= render 'home/card', playing: playing, page: 'mt-0' %>
      <% end %>
    </div>
  </div>
  <div class="genre flex flex-col mt-[2rem] w-full">
    <div class="genre-content flex flex-row justify-between pl-8 pb-5">
      <p class="genre-title font-bold text-3xl">Top Rated Shows</p>
      <a href="/view_all?key=top_rated_shows&type=series" class="text-[red] place-self-center mr-6">View All</a>
    </div>
    <div class="flex flex-row overflow-x-auto">
      <% @top_rated_shows['results']&.each do |playing| %>
        <%= render 'home/tv_card', playing: playing, page: 'mt-0' %>
      <% end %>
    </div>
  </div>
  <div class="genre flex flex-col mt-[2rem] w-full">
    <div class="genre-content flex flex-row justify-between pl-8 pb-5">
      <p class="genre-title font-bold text-3xl">Top Rated Movies</p>
      <a href="/view_all?key=top_rated_movies" class="text-[red] place-self-center mr-6">View All</a>
    </div>
    <div class="flex flex-row overflow-x-auto">
      <% @top_rated_movies['results']&.each do |playing| %>
        <%= render 'home/card', playing: playing, page: 'mt-0' %>
      <% end %>
    </div>
  </div>
  <%= render 'home/movie_modal' %>
  <%= render 'home/season_modal' %>
  <%= render "home/movie_play_modal" %>
  <%= render "tv_shows/watch_season_episodes" %>
  <% unless user_signed_in? %>
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <div id="g_id_onload"
         data-client_id="<%= ENV['GOOGLE_CLIENT_ID'] %>"
         data-login_uri="<%= google_onetap_callback_path %>"
         data-authenticity_token="<%= form_authenticity_token %>"
         data-itp_support="true"
    >
    </div>
  <% end %>
</main>
<%= javascript_include_tag('slick') %>
<%= javascript_include_tag('home/home_modal') %>
<%= javascript_include_tag('home/slick_play_modal') %>
