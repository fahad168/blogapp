<%= render 'shared/header', padding: 'py-4' %>
<div class="px-20 mt-5">
    <section class="multiple-items hidden section" id="multiple_items">
      <% @slider.each do |slider, index| %>
          <%= render "home/slick_slider" , i: index, slider: slider %>
      <% end %>
    </section>

  <section class="mt-20 section">
    <div class="flex flex-row justify-center px-20">
      <div class="flex flex-col justify-center w-full" id="blogsLoader" style="display: none">
        <div class="spinner-container">
          <div class="spinner">
            <div class="spinner">
              <div class="spinner">
                <div class="spinner">
                  <div class="spinner">
                    <div class="spinner"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="flex flex-col justify-start w-full" id="replaceBlogs">
          <%= render 'home/index_blogs' %>
      </div>
      <div class="flex flex-col justify-start">
        <div class="flex flex-row justify-between rounded-full p-5 bg-white shadow-lg peer-focus:border-2">
          <input placeholder="Search..." class="search-header__input w-[80%] bg-transparent focus:outline-none pl-3" type="text" />
          <button>
            <svg fill="none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" height="1.5em" width="1.5em">
              <path d="M4 9a5 5 0 1110 0A5 5 0 014 9zm5-7a7 7 0 104.2 12.6.999.999 0 00.093.107l3 3a1 1 0 001.414-1.414l-3-3a.999.999 0 00-.107-.093A7 7 0 009 2z" fill-rule="evenodd" fill="black"></path>
            </svg>
          </button>
        </div>
        <div class="h-[30rem] w-[25rem] bg-[#F9F9F9] rounded-xl mt-10 shadow-sm">
          <p class="text-[#1E215A] text-2xl font-bold pt-6 pl-5 pr-5">Categories</p>
          <ul class="pl-5 pt-8">
            <li class="font-semibold font-lg text-[#1E215A] border-b border-[#DDDDDD] pb-3 hover:opacity-75 hover:underline cursor-pointer">
              Culture
            </li>
            <li class="mt-3 font-semibold font-lg text-[#1E215A] border-b border-[#DDDDDD] pb-3 hover:opacity-75 hover:underline cursor-pointer">
              Culture
            </li>
            <li class="mt-3 font-semibold font-lg text-[#1E215A] border-b border-[#DDDDDD] pb-3 hover:opacity-75 hover:underline cursor-pointer">
              Culture
            </li>
            <li class="mt-3 font-semibold font-lg text-[#1E215A] border-b border-[#DDDDDD] pb-3 hover:opacity-75 hover:underline cursor-pointer">
              Culture
            </li>
            <li class="mt-3 font-semibold font-lg text-[#1E215A] border-b border-[#DDDDDD] pb-3 hover:opacity-75 hover:underline cursor-pointer">
              Culture
            </li>
            <li class="mt-3 font-semibold font-lg text-[#1E215A] border-b border-[#DDDDDD] pb-3 hover:opacity-75 hover:underline cursor-pointer">
              Culture
            </li>
            <li class="mt-3 font-semibold font-lg text-[#1E215A] border-b border-[#DDDDDD] pb-3 hover:opacity-75 hover:underline cursor-pointer">
              Culture
            </li>
            <li class="mt-3 font-semibold font-lg text-[#1E215A] hover:opacity-75 hover:underline cursor-pointer">
              Culture
            </li>
          </ul>
        </div>
        <div class="h-[40rem] w-[25rem] bg-[#F9F9F9] rounded-xl mt-20 shadow-sm">
          <p class="text-[#1E215A] text-2xl font-bold pt-6 pl-5 pr-5">Top Posts</p>
          <ul class="pl-5 pt-8">
            <% [1,2,3,4,5].each_with_index do |post, index| %>
              <li class="font-semibold font-lg text-[#1E215A] <%= index > 0 ? 'mt-5' : '' %>">
                <div class="flex flex-row justify-start">
                  <p class="text-[2.5rem] font-bold text-[#1E215A]"><%= index + 1%></p>
                  <div class="flex flex-col justify-start ml-5">
                    <p class="text-[#1E215A] mt-2 leading-7 hover:opacity-75 hover:underline cursor-pointer">There are many variations of passages of Lorem Ipsum available.</p>
                    <p class="text-[#8C98A2] font-normal text-sm mt-1">Food, Travel - NOV 17, 2020</p>
                  </div>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
        <div class="mt-10 w-full">
          <p class="text-[#1E215A] text-2xl font-bold pt-6">Top Writers</p>
          <div class="mt-6 flex flex-row justify-start flex-wrap w-[24rem]">
            <% [1,2,3,4,5,6].each_with_index do |i, index| %>
                <img src="<%= asset_path("author#{index + 1}") %>" class="w-[7rem] h-[7rem] mr-4 rounded-lg mt-4 cursor-pointer hover:opacity-75">
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mt-20 px-20">
    <p class="text-[#1E215A] text-2xl font-bold">Most Selling Items</p>
    <div class="flex flex-row flex-wrap justify-between mt-5">
      <% [1, 2, 3, 4, 5, 6, 7, 8].each do |i| %>
        <%= render 'home/product_card', i: i %>
      <% end %>
    </div>
  </section>
</div>

<%= javascript_include_tag('slick') %>

<script>
   $(document).ready(function () {
       var prevPage = $('.previous_page')
       if (prevPage && prevPage[0]?.classList?.contains('disabled')) {
           prevPage[0].style.display = "none"
       }
       var nextPage = $('.next_page')
       if (nextPage && nextPage[0]?.classList?.contains('disabled')) {
           nextPage[0].style.display = "none"
       }
       document.getElementById('multiple_items').classList.remove('hidden')
       $('.multiple-items').slick({
           autoplay: false,
           arrows: true,
           adaptiveHeight: true,
           fade: true,
           cssEase: 'linear',
           infinite: true,
           speed: 2000,
       })
       if ($('#multiple_items .slick-prev').length !== 0) {
           $('#multiple_items .slick-prev')[0].style.display = 'none'
           $('#multiple_items .slick-next')[0].style.display = 'none'
       }
   })

   document.addEventListener('click', function(event) {
       if (event.target.closest('.pagination a')) {
           document.getElementById('blogsLoader').style.display = 'flex'
           document.getElementById('replaceBlogs').style.display = 'none'
           event.preventDefault();
           var page = event.target.closest('.pagination a').getAttribute('aria-label').split(' ')[1];
           $.ajax({
               url: `/?page=${page}`,
               type: 'GET',
               success: function (res) {
                   $('#replaceBlogs').html(res?.entries);
               }
           });
       }
   });

   document.addEventListener('click', function(event) {
       if (event.target.closest('.pagination a')) {
           document.getElementById('blogsLoader').style.display = 'flex'
           document.getElementById('replaceBlogs').style.display = 'none'
           event.preventDefault();
           var page = event.target.closest('.pagination a').getAttribute('aria-label').split(' ')[1];
           ajaxCall(page)
       }
   });

   document.addEventListener('click', function(event) {
       if (event.target.matches('.previous_page') || event.target.matches('.next_page')) {
           document.getElementById('blogsLoader').style.display = 'flex'
           document.getElementById('replaceBlogs').style.display = 'none'
           event.preventDefault();
           var page = parseInt(document.querySelector('.current').getAttribute('aria-label').split(' ')[1]);
           if (event.target.matches('.previous_page')) {
               page -= 1;
           } else if (event.target.matches('.next_page')) {
               page += 1;
           }
           ajaxCall(page);
       }
   });

   function ajaxCall(page) {
       $.ajax({
           url: `/?page=${page}`,
           type: 'GET',
           success: function (res) {
               $('#replaceBlogs').html(res?.entries);
               document.getElementById('blogsLoader').style.display = 'none'
               document.getElementById('replaceBlogs').style.display = 'flex'
           }
       });
   }

   function show_slider_image(id) {
       document.getElementById(`skeletonLoader_${id}`).style.display = 'none'
       document.getElementById(`slider_${id}`).classList.remove('hidden')
       if ($('#multiple_items .slick-prev').length !== 0) {
           setTimeout(function () {
               $('#multiple_items .slick-prev')[0].style.display = 'flex'
               $('#multiple_items .slick-next')[0].style.display = 'flex'
           }, 1000)
       }
   }
</script>
