<div class="relative bg-[#141414] rounded-lg shadow dark:bg-gray-700" id="seasondate">
  <input hidden="hidden" value="<%= @season_detail['id'] %>" id="season_id">
  <div class="absolute flex items-center justify-between -m-3 rounded-2xl bg-white place-self-end" style="z-index: 1">
    <button type="button" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ml-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white" onclick="hideSeasonModal()">
      <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
      </svg>
      <span class="sr-only">Close modal</span>
    </button>
  </div>
  <% if @trailer.present? %>
    <div class="relative">
      <div class="w-full h-[30rem] rounded-t-lg">
        <iframe
          id="iframe"
          width="100%"
          src="https://www.youtube.com/embed/<%= @trailer['key'] %>?controls=1&autoplay=0"
          frameborder="0"
          allowfullscreen
          class="w-full h-[30rem] object-cover rounded-t-lg rounded-b-lg"
        ></iframe>
      </div>
    </div>
  <% else %>
    <div class="relative">
      <img src="<%= ENV['TMBD_IMAGE_URL'] %>/w780/<%= @season_detail['poster_path'] %>" class="w-full h-[35rem]" alt="poster">
      <div class="absolute inset-x-0 bottom-0 h-[5rem] bg-gradient-to-t from-[#141414] to-transparent"></div>
    </div>
  <% end %>
  <div>
    <div class="flex flex-col">
      <p class="text-4xl pl-5 font-bold"><%= @season_detail['original_name'] %></p>
      <div class="flex flex-row pl-5 mt-2 items-center">
        <img src="<%= asset_path('add.svg') %>" class="mr-3 cursor-pointer zoom-on-hover" onclick="<%= user_signed_in? ? "open_season_albums(#{@season_detail['id']})" : 'show_toast()' %>" alt="add">
        <p class="text-gray-500 dark:text-gray-400"><%= @season_detail['first_air_date'].split('-').first %></p>
        <p class="text-gray-500 dark:text-gray-400 ml-2"><%= @season_detail['number_of_seasons'] %> Seasons</p>
      </div>
      <div class="pl-5 mt-3">
        <p class="text-gray-500 dark:text-gray-400">
          <%= @season_detail['overview'] %>
        </p>
      </div>
    </div>
    <div class="genre flex flex-col w-full mt-[5rem]" data-controller="modal-data">
      <div class="genre-content flex flex-row justify-between pl-8 pb-2">
        <p class="genre-title font-bold text-2xl place-self-center">Episodes</p>
        <select id="season_select" class="nice-select mr-6 bg-white robo-font mb-2 text-base flex items-center leading-tight text-[1.16888rem] rounded-[0.76369rem] text-[black] border-2 border-[black] active:border-[black] focus:border-[black] hover:border-[black] h-[3rem]" onchange="get_episode_details()">
          <% @season_detail['seasons'].each_with_index do |season| %>
            <option value="<%= season['season_number'] %>">Season <%= season['season_number'] %> (Episodes <%= season['episode_count'] %>)</option>
          <% end %>
        </select>
      </div>
      <div class="border-b border-1 border-[white] mt-2"></div>
      <div class="flex flex-col m-5 overflow-x-auto" id="episodes">
        <%= render 'home/episode_details' %>
      </div>
    </div>
    <%# if @similar_movies.present? %>
<!--      <div class="genre flex flex-col mt-[2rem] w-full">-->
<!--        <div class="genre-content pl-8 pb-5">-->
<!--          <p class="genre-title font-bold text-3xl">Similar Movies</p>-->
<!--        </div>-->
<!--        <div class="flex flex-row overflow-x-auto">-->
          <%# @similar_movies['results']&.each do |playing| %>
            <%#= render 'home/card', playing: playing %>
          <%# end %>
<!--        </div>-->
<!--      </div>-->
    <%# end %>
  </div>
</div>
<%= render "home/series_album_modal" %>

<script>
    function show_toast() {
        $.toast({
            heading: 'Warning',
            text: 'Needs Sign In before Adding to Favourites',
            showHideTransition: 'slide',
            position: 'top-right',
            icon: 'warning',
            hideAfter: 5000,
            bgColor: 'red',
            textColor: 'white'
        })
    }

    function open_season_albums(series_id) {
        document.getElementById('selectSeriesAlbum').style.display = 'flex'
        document.getElementById('selectSeriesAlbum').style.justifyContent = 'center'
        document.getElementById('series_id').value = series_id
    }
</script>
