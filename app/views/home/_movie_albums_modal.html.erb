<div id="selectAlbum" tabindex="-1" aria-hidden="true" class="overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full" style="display: none">
  <div class="relative p-4 w-full max-w-4xl max-h-full">
    <div class="relative bg-black rounded-lg shadow dark:bg-gray-700">
      <div class="flex items-center justify-between p-4 md:p-5 border-b rounded-t dark:border-gray-600">
        <h3 class="text-lg font-semibold text-white">
          Select Movie Album
        </h3>
        <button type="button" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white" onclick="close_select_album()">
          <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
          </svg>
          <span class="sr-only">Close modal</span>
        </button>
      </div>
      <input name="movie_id" id="movie_id" class="hidden">
      <p id="error" class="text-[red] text-center mt-2"></p>
      <% albums = current_user&.albums&.where(album_type: 'movie') %>
      <div class="flex flex-row justify-evenly flex-wrap mt-5 mb-5">
        <% albums&.each do |album| %>
          <div class="radio-inputs">
            <label>
              <input class="radio-input" type="radio" name="id" value="<%= album.id %>" id="album-radio">
              <span class="radio-tile">
                <span class="radio-icon">
                  <img src="<%= album.album_image.blob.url %>" class="object-cover w-[350px] h-[350px] rounded-lg" alt="album Image">
                </span>
                <span class="radio-label absolute"><%= album.title %></span>
              </span>
            </label>
          </div>
        <% end %>
      </div>
      <div class="flex flex-row justify-end m-10">
        <button type="button" class='cursor-pointer mb-10 bg-[blue] text-white inline-flex items-center hover:opacity-75 focus:outline-none font-medium rounded-lg text-sm px-5 py-2.5 text-center border-2 border-[gray]' onclick="add_movie()">
          Continue
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function add_movie() {
      document.querySelectorAll('#album-radio').forEach(function test(album) {
          if(album.checked === true) {
              var value = album.value
          }
          if(value === undefined) {
              document.getElementById('error').innerText = "Please select movie album"
          } else {
              const loaderContainer = document.getElementById("loader-container1");
              loaderContainer.style.display = "flex"
              var movie_id = document.getElementById('movie_id').value
              var csrfToken = $('meta[name="csrf-token"]').attr('content');
              $.ajax({
                  type: 'POST',
                  url: '/add_movie',
                  data: { album_id: value, movie_id: movie_id, authenticity_token: csrfToken },
                  success: function (response) {
                      if(response?.message) {
                          $.toast({
                              heading: 'Success',
                              text: response.message,
                              showHideTransition: 'slide',
                              position: 'top-right',
                              icon: 'success',
                              hideAfter: 5000,
                              bgColor: 'green',
                              textColor: 'white'
                          })
                          document.getElementById('selectAlbum').style.display = "none"
                      }
                      loaderContainer.style.display = "none"
                  }
              })
          }
      })
  }

  function close_select_album() {
      document.getElementById('selectAlbum').style.display = "none"
  }
</script>
