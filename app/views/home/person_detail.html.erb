<% content_for :title, @person_details['name'] %>

<main class="max-w-[1920px] mx-auto relative h-screen container" id="indexFile" data-controller="modal-data">
  <%= render "shared/header" %>
  <div class="-mt-[88px]">
    <div class="relative">
      <div class="h-[20rem] flex items-center" style="background-image: url(<%= asset_path("person_details_bg.jpg") %>); object-fit: fill; background-position: center">
        <img src="<%= ENV['TMBD_IMAGE_URL'] %>/w500/<%= @person_details['profile_path'] %>" class="w-[10rem] h-[15rem] rounded-xl object-cover mt-[25rem] ml-[15rem]" alt="profile image">
        <div class="flex flex-col mt-[29rem] ml-[2rem]">
          <div class="flex flex-row">
            <p class="text-[white] text-2xl"><%= @person_details['name'] %></p>
            <p class="ml-3 text-md pl-2 pr-2 pt-1 pb-1 bg-[green] text-white text-center rounded-lg" ><%= @person_details['known_for_department'] %></p>
          </div>
          <div>
            <p><%= @person_details['place_of_birth'] %></p>
          </div>
          <div>
            <% if @person_details['deathday'].present? %>
              <p>(<%= @person_details['birthday'] %>) to (<%= @person_details['deathday'] %>)</p>
            <% else %>
              <p><%= @person_details['birthday'] %></p>
            <% end %>
          </div>
        </div>
      </div>
      <div class="mt-[12rem] ml-[15rem]">
        <p><%= @person_details['biography'] %></p>
      </div>
      <div class="flex flex-col mt-[5rem]">
        <p class="genre-title font-bold text-3xl cursor-pointer ml-7" style="z-index: 1">Movies & TV Shows</p>
        <div class="flex flex-row flex-wrap justify-start mt-4 mb-10">
          <% @person_data['cast']&.each do |movie| %>
            <% if movie['media_type'] == 'movie' || !movie['media_type'] %>
              <%= render 'home/card', playing: movie, page: 'mt-5' %>
            <% elsif movie['media_type'] == 'tv' %>
              <%= render 'home/tv_card', playing: movie, page: 'mt-5' %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</main>
<%= render 'home/movie_modal' %>
<%= render 'home/season_modal' %>
<%= javascript_include_tag('home/home_modal') %>
