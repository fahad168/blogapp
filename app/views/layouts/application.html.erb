<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "MoviesCorn" %></title>
    <meta name="description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : 'MoviesCorn' %>">
    <meta name="keywords" content="<%= content_for?(:keywords) ? yield(:keywords) : 'MoviesCorn' %>">
    <meta name="images" content="<%= content_for?(:images) ? yield(:images) : 'https://moviescorn.com/assets/background_image2.jpg' %>">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="google-adsense-account" content="ca-pub-4884445298201901">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield(:meta_tags) %>
    <%= favicon_link_tag('web_logo.svg', class: 'w-16 h-16') %>
    <% set_meta_tags title: content_for?(:title) ? yield(:title) : "MoviesCorn",
                     description: content_for?(:meta_description) ? yield(:meta_description) : "MoviesCorn",
                     keywords: content_for?(:keywords) ? yield(:keywords) : 'MoviesCorn',
                     og: {
                       title: content_for?(:og_title) ? yield(:og_title) : "MoviesCorn",
                       description: content_for?(:og_description) ? yield(:og_description) : "Watch Movies And Tv Shows Online Free",
                       image: content_for?(:og_image) ? yield(:og_image) : "https://moviescorn.com/assets/background_image2.jpg",
                       url: request.original_url,
                       type: "website"
                     },
                     twitter: {
                       card: "summary_large_image",
                       site: "@your_twitter_handle",
                       title: content_for?(:twitter_title) ? yield(:twitter_title) : "MoviesCorn",
                       description: content_for?(:twitter_description) ? yield(:twitter_description) : "Watch Movies And Tv Shows Online Free",
                       image: {
                         _: content_for?(:twitter_image) ? yield(:twitter_image) : "https://moviescorn.com/assets/background_image2.jpg",
                         width: 800,
                         height: 400
                       }
                     } %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<!--    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-modal/0.9.1/jquery.modal.min.js"></script>-->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-nice-select/1.1.0/js/jquery.nice-select.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-toast-plugin/1.3.2/jquery.toast.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-nice-select/1.1.0/css/nice-select.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/1.7.0/flowbite.min.js"></script>
<!--    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4884445298201901" crossorigin="anonymous"></script>-->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BN24MBX547"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-BN24MBX547');
    </script>
    <!--    <script src="https://cdn.jsdelivr.net/npm/lazyload@2.0.0-rc.2/lazyload.js"></script>-->
    <%= javascript_importmap_tags %>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700;800;900&family=Roboto:wght@100;300;400;500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700&family=Poppins:wght@100;200;300;400;500;600;700;800;900&family=Roboto:wght@100;300;400;500;700&display=swap" rel="stylesheet">
<!--    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-modal/0.9.1/jquery.modal.min.css" />-->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-toast-plugin/1.3.2/jquery.toast.css" />
  </head>

  <body class="bg-[black]">
  <div id="loader-container1">
    <div class="loader">
      <div class="dot dot1"></div>
      <div class="dot dot2"></div>
      <div class="dot dot3"></div>
    </div>
  </div>
  <div class="container center" id="loader-container">
    <div class="rope center">
      <div class="legs center">
        <div class="boot-l"></div>
        <div class="boot-r"></div>
      </div>
      <div class="costume center">
        <div class="spider">
          <div class="s1 center"></div>
          <div class="s2 center"></div>
          <div class="s3"></div>
          <div class="s4"></div>
        </div>
        <div class="belt center"></div>
        <div class="hand-r"></div>
        <div class="hand-l"></div>
        <div class="neck center"></div>
        <div class="mask center">
          <div class="eye-l"></div>
          <div class="eye-r"></div>
        </div>
        <div class="cover center"></div>
      </div>
  </div></div>
  <div id="overlay" class="overlay hidden"></div>
  <%= yield %>
  <% if flash[:notice].present? %>
    <script>
        $.toast({
            heading: 'Success',
            text: '<%= flash[:notice] %>',
            showHideTransition: 'slide',
            position: 'top-right',
            icon: 'success',
            hideAfter: 5000,
            bgColor: 'green',
            textColor: 'white'
        })
    </script>
  <% end %>
  <% if flash[:alert].present? %>
    <script>
        $.toast({
            heading: 'Error',
            text: '<%= flash[:alert] %>',
            showHideTransition: 'slide',
            position: 'top-right',
            icon: 'error',
            hideAfter: 5000,
            bgColor: 'red',
            textColor: 'white'
        })
    </script>
  <% end %>
  <% if params[:controller] != 'registrations' && params[:controller] != 'devise/sessions' %>
    <%= render 'shared/bottom_bar' %>
  <% end %>
  <script type='text/javascript' src='//pl21988063.toprevenuegate.com/54/fd/1a/54fd1a178e96b0016a55cfe5ba3786fa.js'></script>
  </body>
</html>
