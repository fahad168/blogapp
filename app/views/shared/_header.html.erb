<section class="px-5 lg:px-16 fixed top-0 left-0 w-full z-10 bg-black opacity-60 rounded-br-xl rounded-bl-xl">
  <div class="py-4 flex justify-between items-center gap-2 sm:gap-4 relative">
    <div class="flex gap-3 sm:gap-5 items-center">
      <%= link_to '/', class: "font-bold block w-28 md:w-36 text-[white] text-4xl" do %>
        <div class="flex flex-row">
          <p>M</p>
          <div class="mt-[0.6rem]">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 26 26" fill="red" width="28">
              <polygon class="play-btn__svg" points="9.33 6.69 9.33 19.39 19.3 13.04 9.33 6.69"/>
              <path class="play-btn__svg" d="M26,13A13,13,0,1,1,13,0,13,13,0,0,1,26,13ZM13,2.18A10.89,10.89,0,1,0,23.84,13.06,10.89,10.89,0,0,0,13,2.18Z"/>
            </svg>
          </div>
          <p>vie</p>
          <div class="bg-[red] flex flex-row rounded-lg ml-1 mt-1">
            <p class="text-[black] pl-1 pr-1">Corn</p>
          </div>
        </div>
      <% end %>
    </div>
    <ul class="absolute md:static shadow md:shadow-none z-50 md:z-30 p-5 md:p-0 hidden md:flex gap-8 items-center">
      <li>
        <%= link_to "Home", '/', data: { turbo: false }, class: "block hover:text-[red] py-2 robo-font text-base #{params[:controller] == 'home' && params[:page] != "movies" && params[:page] != "tv_show" ? 'text-base font-medium text-[red] text-xl' : 'text-[white]'}" %>
      </li>
      <li>
        <%= link_to "Movies", '/movies', data: { turbo: false }, class: "block hover:text-[red] py-2 robo-font text-base #{params[:controller] == 'movies' || params[:page] == "movies" ? 'text-base font-medium text-[red] text-xl' : 'text-[white]'}" %>
      </li>
      <li>
        <%= link_to "TV Shows", '/tv_shows', data: { turbo: false }, class: "block hover:text-[red] py-2 robo-font text-base #{params[:controller] == 'tv_shows' || params[:page] == "tv_show" ? 'text-base font-medium text-[red] text-xl' : 'text-[white]'}" %>
      </li>
      <li>
        <%= link_to "Albums", '/other_albums', data: { turbo: false }, class: "block hover:text-[red] py-2 robo-font text-base #{params[:controller] == 'other_users' ? 'text-base font-medium text-[red] text-xl' : 'text-[white]'}" %>
      </li>
      <li>
        <%= link_to "About", '', class: "block hover:text-[white] py-2 robo-font text-base text-[white]" %>
      </li>
    </ul>
    <% if user_signed_in? %>
      <div class="flex flex-row justify-end">
        <div class="input-wrapper">
          <%= form_with(url: "/search_results", method: :get, data: { turbo: false }) do |f| %>
          <button class="icon" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" height="25px" width="25px">
              <path stroke-linejoin="round" stroke-linecap="round" stroke-width="1.5" stroke="#fff" d="M11.5 21C16.7467 21 21 16.7467 21 11.5C21 6.25329 16.7467 2 11.5 2C6.25329 2 2 6.25329 2 11.5C2 16.7467 6.25329 21 11.5 21Z"></path>
              <path stroke-linejoin="round" stroke-linecap="round" stroke-width="1.5" stroke="#fff" d="M22 22L20 20"></path>
            </svg>
          </button>
            <% if params[:controller] == 'home' %>
              <%= f.hidden_field :page, value: 'home' %>
            <% elsif params[:controller] == 'movies' %>
              <%= f.hidden_field :page, value: 'movies' %>
            <% else %>
              <%= f.hidden_field :page, value: 'tv_show' %>
            <% end %>
            <input value="<%= params[:q].present? ? params[:q] : '' %>" placeholder="<%= if params[:controller] == 'home'
                                      'Movies, Tv Shows, People'
                                    else
                                      params[:controller] == 'movies' ? 'Search movies' : 'Search tv shows'
                                    end %>" class="input" name="q" type="text">
            <%#= f.submit "" %>
          <% end %>
        </div>
        <div class="">
          <button id="dropdownUserAvatarButton" data-dropdown-toggle="dropdownAvatar" class="flex mx-3 bg-gray-400 rounded-full" type="button">
            <img src="<%= current_user.profile_image.present? ? current_user.profile_image.blob.url : asset_path('user.svg') %>" loading="lazy" class="w-10 h-10 rounded-full object-cover">
            <%#= image_tag current_user.profile_image.present? ? current_user.profile_image.blob.url : 'user.svg', alt: '', class: "lazyload w-10 h-10 rounded-full object-cover" %>
          </button>
          <div id="dropdownAvatar" class="z-10 hidden bg-white divide-y divide-gray-100 rounded-lg shadow w-44">
            <div class="px-4 py-3 text-sm text-gray-900">
              <div><%= current_user.username %></div>
              <div class="font-medium truncate"><%= current_user.email %></div>
            </div>
            <ul class="py-2 text-sm text-gray-700 px-4" aria-labelledby="dropdownUserAvatarButton">
              <li class="hover:text-[gray]">
                <%= link_to "Profile", profile_path, data: { turbo: false }, class: "block py-2 hover:bg-gray-100 rounded-lg" %>
              </li>
              <li class="hover:text-[gray] mt-2">
                <%= link_to "Settings", settings_path, class: "block py-2 hover:bg-gray-100 rounded-lg" %>
              </li>
            </ul>
            <div class="py-2">
              <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: 'block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100' do %>
                Sign Out
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <%  else  %>
      <a class="bg-[white] w-[6rem] h-[3rem] rounded-lg text-center" href="/users/sign_in">
        <p class="text-center text-[black] mt-[0.5rem]">Sign In</p>
      </a>
    <%  end %>
  </div>
</section>
