<section class="px-5 lg:px-16 sticky top-0 left-0 w-full z-10">
  <div class="py-4 flex justify-between items-center gap-2 sm:gap-4 relative">
    <div class="flex gap-3 sm:gap-5 items-center">
      <%= link_to '/', class: "font-bold block w-28 md:w-36 h-12 md:h-14 text-[white] text-3xl" do %>
        MoVieCorN
      <% end %>
    </div>
    <ul class="absolute md:static shadow md:shadow-none z-50 md:z-30 p-5 md:p-0 hidden md:flex gap-8 items-center">
      <li>
        <%= link_to "Home", '/', class: "block hover:text-[white] py-2 robo-font text-base #{params[:controller] == 'home' ? 'text-base font-medium text-[red] text-xl' : 'text-[white]'}" %>
      </li>
      <li>
        <%= link_to "Movies", '/movies', class: "block hover:text-[white] py-2 robo-font text-base #{params[:controller] == 'movies' ? 'text-base font-medium text-[red] text-xl' : 'text-[white]'}" %>
      </li>
      <li>
        <%= link_to "TV Shows", '/tv_shows', class: "block hover:text-[white] py-2 robo-font text-base #{params[:controller] == 'tv_shows' ? 'text-base font-medium text-[red] text-xl' : 'text-[white]'}" %>
      </li>
      <li>
        <%= link_to "Premium", '', class: "block hover:text-[white] py-2 robo-font text-base text-[white]" %>
      </li>
      <li>
        <%= link_to "About", '', class: "block hover:text-[white] py-2 robo-font text-base text-[white]" %>
      </li>
    </ul>
    <button class="bg-[white] w-[6rem] h-[3rem] rounded-lg">
      Sign Up
    </button>
  </div>
</section>
