<main class="max-w-[1920px] mx-auto relative h-screen container" id="indexFile" data-controller="modal-data">
  <%= render "shared/header" %>
  <div class="">
    <%= render 'profile/top_profile' %>
    <div class="flex flex-row justify-center lg:mt-0 mt-[5rem]">
      <div class="flex flex-row justify-start md:hidden -mt-5 -ml-3 -mr-3">
        <label class="hamburger absolute">
          <input type="checkbox" onclick="show_sidebar()">
          <svg viewBox="0 0 32 32">
            <path class="line line-top-bottom" d="M27 10 13 10C10.8 10 9 8.2 9 6 9 3.5 10.8 2 13 2 15.2 2 17 3.8 17 6L17 26C17 28.2 18.8 30 21 30 23.2 30 25 28.2 25 26 25 23.8 23.2 22 21 22L7 22"></path>
            <path class="line" d="M7 16 27 16"></path>
          </svg>
        </label>
      </div>
      <div class="md:block hidden border-2 border-[grey] h-[25rem] w-[15%] mt-10 ml-10 rounded-lg" id="sidebar">
        <%= render 'profile/new_sidebar' %>
      </div>
      <div class="min-h-[25rem] border-2 border-[grey] md:w-[50%] w-full mt-10 ml-10 rounded-lg overflow-y-scroll max-h-[40rem] md:mb-0 mb-[8rem]">
        <p class="text-center mt-5">Follow Requests</p>
        <div class="flex flex-col pt-10 lg:w-[80%] w-full lg:ml-[6rem] lg:pr-0 lg:pl-0 md:pl-4 md:pr-4 pr-2 pl-2" id="item-list">
          <% if @pending_requests.present? %>
            <% @pending_requests.each_with_index do |request, index| %>
              <% user = User.find_by(id: request.follower_id) %>
              <%= form_with(url: '/update_request', method: :post, data: { turbo: false }) do |f| %>
                <%= f.hidden_field :type, id: 'type' %>
                <%= f.hidden_field :follower_id, value: request.follower_id %>
                <div class="bg-[#494F55] shadow-[0_0_4px_0_rgba(0,0,0,0.25)] rounded-lg flex lg:flex-row flex-col justify-between searchable-item mb-10 p-4">
                  <div class="flex flex-row justify-start">
                    <img class="w-10 h-10 rounded-full object-cover <%= user.profile_image.attached? ? '' : 'border-2 border-[grey]' %>" src="<%= user.profile_image.attached? ? user.profile_image.blob.url : asset_path('user.svg') %>" loading="lazy" alt="profile image">
                    <p class="text-center lg:ml-5 ml-1 lg:text-lg text-sm hover:underline cursor-pointer lg:mt-1 mt-3" data-searchable="item<%= index %>"><%= user.username %></p>
                  </div>
                  <div class="flex lg:flex-row flex-col lg:w-[35%] w-full justify-between">
                    <button type="button" class="lg:mt-0 mt-3 md:text-lg text-xs relative p-2 text-black text-base font-bold rounded-lg overflow-hidden bg-white transition-all duration-400 ease-in-out shadow-md hover:scale-105 hover:text-white hover:shadow-lg active:scale-90 before:absolute before:top-0 before:-left-full before:w-full before:h-full before:bg-gradient-to-r before:from-blue-500 before:to-blue-400 before:transition-all before:duration-500 before:ease-in-out before:z-[-1] before:rounded-lg hover:before:left-0" onclick="submit_form(this)">
                      Accept
                    </button>
                    <button type="button" class="lg:mt-0 mt-3 relative md:text-lg text-xs p-2 text-black text-base font-bold rounded-lg overflow-hidden bg-white transition-all duration-400 ease-in-out shadow-md hover:scale-105 hover:text-white hover:shadow-lg active:scale-90 before:absolute before:top-0 before:-left-full before:w-full before:h-full before:bg-gradient-to-r before:from-red-800 before:to-red-700 before:transition-all before:duration-500 before:ease-in-out before:z-[-1] before:rounded-lg hover:before:left-0" onclick="submit_form(this)">
                      Reject
                    </button>
                  </div>
                </div>
                <button type="submit" hidden="hidden" id="submit"></button>
              <% end %>
            <% end %>
          <% else %>
            <p class="text-center text-white mt-[6rem]">No follow requests</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</main>
<%= javascript_include_tag('home/sidebar') %>

<script>
  function submit_form(button) {
      document.getElementById('type').value = button.innerText
      $('#submit').click()
  }
</script>
