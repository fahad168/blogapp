<main class="max-w-[1920px] mx-auto relative h-screen container" id="indexFile" data-controller="modal-data">
  <%= render "shared/header" %>
  <div class="">
    <%= render 'profile/top_profile' %>
    <div class="flex flex-row justify-center mt-[2rem]">
      <div class="border-2 border-[grey] h-[25rem] w-[15%] mt-10 ml-10 rounded-lg">
        <%= render 'profile/sidebar' %>
      </div>
      <div class="border-2 border-[grey] w-[50%] mt-10 ml-10 rounded-lg overflow-y-scroll max-h-[40rem]">
        <p class="text-center mt-5">Follow Requests</p>
        <div class="flex flex-col pt-10 w-[80%] ml-[6rem]" id="item-list">
          <% if @pending_requests.present? %>
            <% @pending_requests.each_with_index do |request, index| %>
              <% user = User.find_by(id: request.follower_id) %>
              <%= form_with(url: '/update_request', method: :post, data: { turbo: false }) do |f| %>
                <%= f.hidden_field :type, id: 'type' %>
                <%= f.hidden_field :follower_id, value: request.follower_id %>
                <div class="bg-[#494F55] shadow-[0_0_4px_0_rgba(0,0,0,0.25)] rounded-lg flex flex-row justify-between searchable-item mb-10 p-4">
                  <div class="flex flex-row justify-start">
                    <img class="w-10 h-10 rounded-full object-cover <%= user.profile_image.attached? ? '' : 'border-2 border-[grey]' %>" src="<%= user.profile_image.attached? ? user.profile_image.blob.url : asset_path('user.svg') %>" loading="lazy" alt="profile image">
                    <p class="text-center ml-5 hover:underline cursor-pointer mt-1" data-searchable="item<%= index %>"><%= user.username %></p>
                  </div>
                  <div class="flex flex-row w-[35%] justify-between">
                    <button type="button" class="relative py-2 px-8 text-black text-base font-bold rounded-lg overflow-hidden bg-white transition-all duration-400 ease-in-out shadow-md hover:scale-105 hover:text-white hover:shadow-lg active:scale-90 before:absolute before:top-0 before:-left-full before:w-full before:h-full before:bg-gradient-to-r before:from-blue-500 before:to-blue-400 before:transition-all before:duration-500 before:ease-in-out before:z-[-1] before:rounded-lg hover:before:left-0" onclick="submit_form(this)">
                      Accept
                    </button>
                    <button type="button" class="relative py-2 px-8 text-black text-base font-bold rounded-lg overflow-hidden bg-white transition-all duration-400 ease-in-out shadow-md hover:scale-105 hover:text-white hover:shadow-lg active:scale-90 before:absolute before:top-0 before:-left-full before:w-full before:h-full before:bg-gradient-to-r before:from-red-800 before:to-red-700 before:transition-all before:duration-500 before:ease-in-out before:z-[-1] before:rounded-lg hover:before:left-0" onclick="submit_form(this)">
                      Reject
                    </button>
                  </div>
                </div>
                <button type="submit" hidden="hidden" id="submit"></button>
              <% end %>
            <% end %>
          <% else %>
            <p class="text-center text-white mt-[6rem]">No follow requests</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</main>

<script>
  function submit_form(button) {
      document.getElementById('type').value = button.innerText
      $('#submit').click()
  }
</script>
