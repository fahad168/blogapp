<div id="additional-details-modal" tabindex="-1" aria-hidden="true" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
  <div class="relative p-4 w-full max-w-xl max-h-full">
    <div class="relative bg-white rounded-lg shadow">
      <div class="flex items-center justify-between p-4 md:p-5 border-b rounded-t">
        <h3 class="text-lg font-semibold text-gray-900">
          Additional Details
        </h3>
        <button type="button" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center" data-modal-toggle="additional-details-modal" id="additional-details-modal-close">
          <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
          </svg>
          <span class="sr-only">Close modal</span>
        </button>
      </div>
      <div class="p-4 md:p-5">
        <div class="grid gap-4 mb-4 grid-cols-1">
          <div class="col-span-2 mt-2">
            <label for="email" class="block mb-2 text-sm font-medium text-gray-900">Email</label>
            <input type="text" name="username" id="email" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" placeholder="Full Name" value="<%= current_user.email %>" disabled style="cursor: not-allowed">
          </div>
          <div class="col-span-2">
            <% all_languages = LanguageList::ALL_LANGUAGES.map { |lang| lang.name  } %>
            <label for="languages" class="block mb-2 text-sm font-medium text-gray-900">Languages</label>
            <%= select_tag("languages", options_for_select(all_languages, include_blank: 'Select Languages', selected: current_user.blogger_profile.languages), { class: 'language_select wide text-sm font-normal text-gray-400 w-full rounded-lg border border-gray-200 mt-2 outline-none', id: 'languages', multiple: true ,placeholder: 'Select Languages'}) %>
          </div>
          <div class="col-span-2">
            <% genders = [%w[Male male], %w[Female female], %w[Transgender transgender]] %>
            <label for="gender" class="block mb-2 text-sm font-medium text-gray-900">Gender</label>
            <select name="gender" id="gender" class="nice-select wide bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5">
              <option>Select Gender</option>
              <% genders.each do |text, value| %>
                <option <%= current_user.profile.gender == value ? 'selected' : '' %> value="<%= value %>"><%= text %></option>
              <% end %>
            </select>
          </div>
          <div class="col-span-2">
            <label for="nickname" class="block mb-2 text-sm font-medium text-gray-900">Nickname</label>
            <input type="text" name="nickname" id="nickname" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" placeholder="Nickname" value="<%= current_user.blogger_profile.nickname %>">
          </div>
        </div>
        <div class="flex flex-row justify-end">
          <button type="button" class="text-white inline-flex items-center bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center" onclick="additional_details()">
            Update Profile
          </button>
        </div>
      </div>
    </div>
  </div>
</div>