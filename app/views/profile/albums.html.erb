<main class="max-w-[1920px] mx-auto relative h-screen container" id="indexFile" data-controller="modal-data">
  <%= render "shared/header" %>
  <div class="-mt-[88px]">
    <%= render 'profile/top_profile' %>
    <div class="flex flex-row justify-center mt-[2rem]">
      <div class="border-2 border-[grey] h-[25rem] w-[15%] mt-10 ml-10 rounded-lg">
        <%= render 'profile/sidebar' %>
      </div>
      <div class="border-2 border-[grey] w-[50%] mt-10 ml-10 rounded-lg">
        <div class="flex justify-end mr-4 mt-3">
          <button class="button bg-[green] rounded-lg w-[10rem] p-2" data-modal-target="crud-modal" data-modal-toggle="crud-modal">Create Album</button>
        </div>
        <div class="flex flex-row flex-wrap">
          <% if @albums.present? %>
            <% @albums.each do |album| %>
              <div class="album_card cursor-pointer" onclick="show_album('<%= album.id %>')">
                <div class="top-section">
                  <div class="border">
                  </div>
                  <div class="w-full h-full">
                    <img src="<%= album.album_image.attached? ? album.album_image.blob.url : asset_path('no_image_found.png') %>" loading="lazy" class="rounded-lg h-[9rem] absolute w-full mt-1">
                  </div>
                  <div class="icons">
                    <div class="logo">
                      <%= album.title.split(' ').first.capitalize %>
                    </div>
                    <div class="social-media">
                      <a href="https://web.whatsapp.com/send?text=<%= CGI.escape(album.shareable_link) %>" data-action="share/whatsapp/share" class="text-white" target="_blank"><img src="<%= asset_path('whatsapp.svg') %>" class="w-[0.8rem]"></a>
                      <a href="https://twitter.com/intent/tweet?url=<%= CGI.escape(album.shareable_link) %>&text=<%= album.title.capitalize %>%20by%20<%= current_user.username.capitalize %>&media=https%3A%2F%2Fimage.tmdb.org%2Ft%2Fp%2Fw780%2F<%= album.album_contents.present? ? album.album_contents.first.img_url : '' %>" class="text-white" target="_blank"><img src="<%= asset_path('twitter.svg') %>" class="w-[0.8rem]"></a>
                      <a href="https://www.facebook.com/sharer.php?u=<%= CGI.escape(album.shareable_link) %>" class="text-white" target="_blank"><img src="<%= asset_path('facebook.svg') %>" class="w-[0.8rem]"></a>
                    </div>
                  </div>
                </div>
                <div class="bottom-section">
                  <span class="title"><%= album.title.capitalize %></span>
                  <div class="row row1">
                    <div class="item">
                      <span class="big-text"><%= album.album_contents.count %></span>
                      <span class="regular-text">Total Movies</span>
                    </div>
                    <div class="item">
                      <span class="big-text"><%= album.total_views %></span>
                      <span class="regular-text">Total View</span>
                    </div>
                    <div class="item">
                      <span class="big-text"><%= album.shared_count %></span>
                      <span class="regular-text">Shared Count</span>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <%= render 'profile/create_album_modal' %>
  <%= render 'profile/shareable_link_modal' %>
  <%= render 'profile/show_album_modal' %>
  <%= render 'home/movie_modal' %>
  <%= render 'home/season_modal' %>
</main>

<%= javascript_include_tag('home/home_modal') %>

<% if flash[:notice].present? %>
  <script>
    $(document).ready(function () {
        var notice = '<%= flash[:notice] %>'
        var shareLink = document.getElementById('shareLink')
        shareLink.value = notice.split('link ')[1]
        document.getElementById('whatsapp').href = `https://web.whatsapp.com/send?text=${shareLink.value}`
        document.getElementById('twitter').href = `https://twitter.com/intent/tweet?url=${shareLink.value}`
        document.getElementById('facebook').href = `https://www.facebook.com/sharer.php?u=${shareLink.value}`
        document.getElementById('mail').href = `mailto:?subject=Shared%20by%20<%= current_user.username.capitalize %>&body=${shareLink.value}`
        document.getElementById('share-modal').style.display = 'flex'
        document.getElementById('overlay').style.display = 'block'
    })
  </script>
<% end %>

<script>
  function close_share_modal() {
      document.getElementById('share-modal').style.display = 'none'
      document.getElementById('overlay').style.display = 'none'
  }

  function show_album(id) {
      const loaderContainer = document.getElementById("loader-container");
      const overlay = document.getElementById("overlay");
      overlay.classList.remove('hidden')
      overlay.style.display = "block"
      loaderContainer.style.display = "block"
      $.ajax({
          type: 'GET',
          url: `/album?id=${id}`,
          success: function (res) {
              $('#albumInnerModal').html(res.entries)
              document.getElementById('albumModal').style.display = "flex"
              document.getElementById('albumModal').style.justifyContent = "center"
              loaderContainer.style.display = "none"
          }
      })
  }

  function hideAlbumModal() {
      document.getElementById('albumModal').style.display = "none"
      const overlay = document.getElementById("overlay");
      overlay.classList.add('hidden')
      overlay.style.display = "none"
  }

</script>
