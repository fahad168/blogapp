<main class="max-w-[1920px] mx-auto relative h-screen container" id="indexFile" data-controller="modal-data">
  <%= render "shared/header" %>
  <div class="">
    <%= render 'profile/top_profile' %>
    <div class="flex flex-row justify-center lg:mt-0 mt-[5rem]">
      <div class="flex flex-row justify-start md:hidden -mr-5 -mt-3">
        <label class="hamburger absolute">
          <input type="checkbox" onclick="show_sidebar()">
          <svg viewBox="0 0 32 32">
            <path class="line line-top-bottom" d="M27 10 13 10C10.8 10 9 8.2 9 6 9 3.5 10.8 2 13 2 15.2 2 17 3.8 17 6L17 26C17 28.2 18.8 30 21 30 23.2 30 25 28.2 25 26 25 23.8 23.2 22 21 22L7 22"></path>
            <path class="line" d="M7 16 27 16"></path>
          </svg>
        </label>
      </div>
      <div class="md:block hidden border-2 border-[grey] h-[25rem] w-[15%] mt-10 ml-10 rounded-lg" id="sidebar">
        <%= render 'profile/new_sidebar' %>
      </div>
      <div class="border-2 border-[grey] md:w-[50%] w-full mt-10 ml-10 rounded-lg md:mb-0 mb-[8rem]">
        <div class="flex justify-end mr-4 mt-3">
          <button class="button bg-[green] rounded-lg w-[10rem] p-2" data-modal-target="crud-modal" data-modal-toggle="crud-modal">Create Album</button>
        </div>
        <div class="flex flex-row flex-wrap">
          <% if @albums.present? %>
            <% @albums.each do |album| %>
              <div class="album_card">
                <div class="top-section">
                  <div class="border">
                  </div>
                  <div class="w-full h-full" onclick="show_album('<%= album.id %>')">
                    <img src="<%= album.album_image.attached? ? album.album_image.blob.url : asset_path('no_image_found.png') %>" loading="lazy" class="rounded-lg h-[9rem] absolute w-full mt-1 cursor-pointer" alt="album image">
                  </div>
                  <div class="icons">
                    <div class="logo">
                      <%= album.title.split(' ').first.capitalize %>
                    </div>
                    <div class="social-media">
                      <a href="https://web.whatsapp.com/send?text=<%= CGI.escape(album.shareable_link) %>" data-action="share/whatsapp/share" class="text-white" target="_blank"><img src="<%= asset_path('whatsapp.svg') %>" class="w-[0.8rem] hover:opacity-75" alt="whatsapp"></a>
                      <a href="https://twitter.com/intent/tweet?url=<%= CGI.escape(album.shareable_link) %>&text=<%= album.title.capitalize %>%20by%20<%= current_user.username.capitalize %>&media=https%3A%2F%2Fimage.tmdb.org%2Ft%2Fp%2Fw780%2F<%= album.album_contents.present? ? album.album_contents.first.img_url : '' %>" class="text-white" target="_blank"><img src="<%= asset_path('twitter.svg') %>" class="w-[0.8rem] hover:opacity-75" alt="twitter"></a>
                      <a href="https://www.facebook.com/sharer.php?u=<%= CGI.escape(album.shareable_link) %>" class="text-white" target="_blank"><img src="<%= asset_path('facebook.svg') %>" class="w-[0.8rem] hover:opacity-75" alt="facebook"></a>
                    </div>
                  </div>
                </div>
                <div class="bottom-section">
                  <div class="flex flex-row justify-between">
                    <span class="title cursor-pointer hover:underline" onclick="show_album('<%= album.id %>')"><%= album.title.capitalize %></span>
                    <%= link_to "/album/#{album.id}", data: { turbo_method: :delete }, class: 'hover:opacity-75' do %>
                      <%= image_tag asset_path('bin.svg') %>
                    <% end %>
                  </div>
                  <div class="row row1">
                    <div class="item">
                      <span class="big-text"><%= album.album_contents.count %></span>
                      <span class="regular-text">Total Movies</span>
                    </div>
                    <div class="item">
                      <span class="big-text"><%= album.total_views %></span>
                      <span class="regular-text">Total View</span>
                    </div>
                    <div class="item">
                      <span class="big-text"><%= album.shared_count %></span>
                      <span class="regular-text">Shared Count</span>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <%= render 'profile/create_album_modal' %>
  <%= render 'profile/shareable_link_modal' %>
  <%= render 'profile/show_album_modal' %>
  <%= render 'home/movie_modal' %>
  <%= render 'home/season_modal' %>
</main>

<%= javascript_include_tag('home/home_modal') %>
<%= javascript_include_tag('home/show_album') %>
<%= javascript_include_tag('home/sidebar') %>

<% if flash[:notice].present? && !flash[:notice].include?('deleted') %>
  <script>
    $(document).ready(function () {
        var notice = '<%= flash[:notice] %>'
        var shareLink = document.getElementById('shareLink')
        shareLink.value = notice.split('link ')[1]
        document.getElementById('whatsapp').href = `https://web.whatsapp.com/send?text=${shareLink.value}`
        document.getElementById('twitter').href = `https://twitter.com/intent/tweet?url=${shareLink.value}`
        document.getElementById('facebook').href = `https://www.facebook.com/sharer.php?u=${shareLink.value}`
        document.getElementById('mail').href = `mailto:?subject=Shared%20by%20<%= current_user.username.capitalize %>&body=${shareLink.value}`
        document.getElementById('share-modal').style.display = 'flex'
        document.getElementById('overlay').style.display = 'block'
    })
  </script>
<% end %>

<script>
  function close_share_modal() {
      document.getElementById('share-modal').style.display = 'none'
      document.getElementById('overlay').style.display = 'none'
  }
</script>
