<% content_for :title, "User Settings" %>

<main class="max-w-[1920px] mx-auto relative h-screen container" id="indexFile" data-controller="modal-data">
  <%= render "shared/header" %>
  <div class="">
    <%= render 'profile/top_profile' %>
    <div class="flex flex-row justify-center lg:mt-0 mt-[5rem]">
      <div class="flex flex-row justify-start md:hidden -mt-5 -mr-8">
        <label class="hamburger absolute">
          <input type="checkbox" onclick="show_sidebar()">
          <svg viewBox="0 0 32 32">
            <path class="line line-top-bottom" d="M27 10 13 10C10.8 10 9 8.2 9 6 9 3.5 10.8 2 13 2 15.2 2 17 3.8 17 6L17 26C17 28.2 18.8 30 21 30 23.2 30 25 28.2 25 26 25 23.8 23.2 22 21 22L7 22"></path>
            <path class="line" d="M7 16 27 16"></path>
          </svg>
        </label>
      </div>
      <div class="md:block hidden border-2 border-[grey] h-[25rem] w-[15%] mt-10 ml-10 rounded-lg" id="sidebar">
        <%= render 'profile/new_sidebar' %>
      </div>
      <div class="min-h-[25rem] border-2 border-[grey] md:w-[50%] w-full mt-10 ml-10 rounded-lg overflow-y-scroll max-h-[40rem] md:mb-0 mb-[8rem]">
        <div class="flex flex-row justify-center mt-10">
          <div class="flex flex-col lg:w-[30rem] w-full lg:pl-0 lg:pr-0 pl-3 pr-3">
            <p class="text-white font-bold text-2xl mb-3 lg:text-start text-center">Privacy</p>
            <div class="flex flex-row justify-between">
              <div class="flex flex-col lg:justify-start justify-center">
                <p class="text-[grey]">Private Account</p>
                <p class="text-sm text-[grey] md:w-full w-[10rem] line-clamp-1">Only followers can see your profile</p>
              </div>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" value="" <%= @settings.private_account == true ? 'checked' : '' %> name="private_account" class="sr-only peer" onchange="update_settings(this)">
                <div class="group peer ring-0 bg-[red] rounded-full outline-none duration-300 after:duration-300 w-24 h-12  shadow-md peer-checked:bg-emerald-500  peer-focus:outline-none  after:content-['✖️']  after:rounded-full after:absolute after:bg-gray-50 after:outline-none after:h-10 after:w-10 after:top-1 after:left-1 after:flex after:justify-center after:items-center peer-checked:after:translate-x-12 peer-checked:after:content-['✔️'] peer-hover:after:scale-95">
                </div>
              </label>
            </div>
            <div class="flex flex-row justify-between mt-10">
              <div class="flex flex-col justify-start">
                <p class="text-[grey]">Private Album</p>
                <p class="text-sm text-[grey] md:w-full w-[10rem] line-clamp-1">Check to make all of albums private</p>
              </div>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" value="" <%= @settings.private_albums == true ? 'checked' : '' %> name="private_albums" class="sr-only peer" onchange="update_settings(this)">
                <div class="group peer ring-0 bg-[red] rounded-full outline-none duration-300 after:duration-300 w-24 h-12  shadow-md peer-checked:bg-emerald-500  peer-focus:outline-none  after:content-['✖️']  after:rounded-full after:absolute after:bg-gray-50 after:outline-none after:h-10 after:w-10 after:top-1 after:left-1 after:flex after:justify-center after:items-center peer-checked:after:translate-x-12 peer-checked:after:content-['✔️'] peer-hover:after:scale-95">
                </div>
              </label>
            </div>
            <p class="text-white font-bold text-2xl mt-6 mb-3 lg:text-start text-center">Others</p>
            <div class="flex flex-row justify-between">
              <div class="flex flex-col justify-start">
                <p class="text-[grey]">Adult Content</p>
                <p class="text-sm text-[grey] md:w-full w-[10rem] line-clamp-1">Will hide adult movies and tv shows</p>
              </div>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" value="" <%= @settings.adult_content == true ? 'checked' : '' %> name="adult_content" class="sr-only peer" onchange="update_settings(this)">
                <div class="group peer ring-0 bg-[red] rounded-full outline-none duration-300 after:duration-300 w-24 h-12  shadow-md peer-checked:bg-emerald-500  peer-focus:outline-none  after:content-['✖️']  after:rounded-full after:absolute after:bg-gray-50 after:outline-none after:h-10 after:w-10 after:top-1 after:left-1 after:flex after:justify-center after:items-center peer-checked:after:translate-x-12 peer-checked:after:content-['✔️'] peer-hover:after:scale-95">
                </div>
              </label>
            </div>
            <p class="text-white font-bold text-2xl mt-6 mb-3 lg:text-start text-center">Account Control</p>
            <div class="flex flex-row justify-between">
              <div class="flex flex-col justify-start">
                <p class="text-[grey]">Delete Account</p>
                <p class="text-sm text-[grey]">This action cannot be reversed</p>
              </div>
              <button class="delete-button" data-modal-target="popup-modal" data-modal-toggle="popup-modal">
                <svg class="delete-svgIcon" viewBox="0 0 448 512">
                  <path d="M135.2 17.7L128 32H32C14.3 32 0 46.3 0 64S14.3 96 32 96H416c17.7 0 32-14.3 32-32s-14.3-32-32-32H320l-7.2-14.3C307.4 6.8 296.3 0 284.2 0H163.8c-12.1 0-23.2 6.8-28.6 17.7zM416 128H32L53.2 467c1.6 25.3 22.6 45 47.9 45H346.9c25.3 0 46.3-19.7 47.9-45L416 128z"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
<%= render "profile/confirmation_modal" %>
<%= javascript_include_tag('home/sidebar') %>

<script>
    function update_settings(input) {
        var checked = input.checked
        $.ajax({
            type: 'GET',
            url: `/update_settings?${input.name}=${checked}`,
            success: function (response) {
                $.toast({
                    heading: 'Success',
                    text: `${ input.name.split('_').join(' ').toUpperCase() } updated successfully`,
                    showHideTransition: 'slide',
                    position: 'top-right',
                    icon: 'success',
                    hideAfter: 5000,
                    bgColor: 'green',
                    textColor: 'white'
                })
            }
        })
    }
</script>
