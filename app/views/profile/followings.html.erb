<main class="max-w-[1920px] mx-auto relative h-screen container" id="indexFile" data-controller="modal-data">
  <%= render "shared/header" %>
  <div class="">
    <%= render 'profile/top_profile' %>
    <div class="flex flex-row justify-center mt-[2rem]">
      <div class="border-2 border-[grey] h-[25rem] w-[15%] mt-10 ml-10 rounded-lg">
        <%= render 'profile/sidebar' %>
      </div>
      <div class="border-2 border-[grey] w-[50%] mt-10 ml-10 rounded-lg overflow-y-scroll max-h-[40rem]">
        <div class="flex flex-row justify-end mr-4 mt-3">
          <input oninput="handleSearch()" name="q" autocomplete="off" id="q_search" type="text" class="border-2 border-[grey] bg-transparent h-[3rem] rounded-md mr-4 mt-6 w-[20rem] pl-3 text-[grey] hover:border-[grey]" placeholder="Search Followings">
          <a href="/explore" class="explore mt-[1.6rem] pl-2 pr-2">
            <svg class="svgIcon" viewBox="0 0 512 512" height="1em" xmlns="http://www.w3.org/2000/svg">
              <path d="M256 512A256 256 0 1 0 256 0a256 256 0 1 0 0 512zm50.7-186.9L162.4 380.6c-19.4 7.5-38.5-11.6-31-31l55.5-144.3c3.3-8.5 9.9-15.1 18.4-18.4l144.3-55.5c19.4-7.5 38.5 11.6 31 31L325.1 306.7c-3.2 8.5-9.9 15.1-18.4 18.4zM288 256a32 32 0 1 0 -64 0 32 32 0 1 0 64 0z"></path>
            </svg>
            Explore
          </a>
        </div>
        <div class="flex flex-col pt-10 w-[80%] ml-[6rem]" id="item-list">
          <% if @followings.present? %>
            <% @followings.each_with_index do |following, index| %>
              <% user = User.find_by(id: following.following_id) %>
              <%= form_with(url: '/unfollow', method: :post, data: { turbo: false }) do |f| %>
                <%= f.hidden_field :following_id, value: following.following_id %>
                <div class="bg-[#494F55] shadow-[0_0_4px_0_rgba(0,0,0,0.25)] rounded-lg flex flex-row justify-between searchable-item mb-10 p-4">
                  <div class="flex flex-row justify-start">
                    <img class="w-10 h-10 rounded-full object-cover <%= user.profile_image.attached? ? '' : 'border-2 border-[grey]' %>" src="<%= user.profile_image.attached? ? user.profile_image.blob.url : asset_path('user.svg') %>" loading="lazy" alt="profile image">
                    <p class="text-center ml-5 hover:underline cursor-pointer mt-1" data-searchable="item<%= index %>"><%= user.username %></p>
                  </div>
                  <button type="submit" class="relative py-2 px-8 text-black text-base font-bold uppercase rounded-lg overflow-hidden bg-white transition-all duration-400 ease-in-out shadow-md hover:scale-105 hover:text-white hover:shadow-lg active:scale-90 before:absolute before:top-0 before:-left-full before:w-full before:h-full before:bg-gradient-to-r before:from-blue-500 before:to-blue-400 before:transition-all before:duration-500 before:ease-in-out before:z-[-1] before:rounded-lg hover:before:left-0">
                    UnFollow
                  </button>
                </div>
              <% end %>
            <% end %>
          <% else %>
            <div class="flex flex-col mt-[3rem]">
              <p class="text-center">No Followings</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</main>

<script>
    function handleSearch() {
        var input, filter, itemList, items, username;
        input = document.getElementById('q_search');
        filter = input.value.toUpperCase();
        itemList = document.getElementById('item-list');
        items = itemList.getElementsByClassName('searchable-item');

        for (var i = 0; i < items.length; i++) {
            username = items[i].getElementsByTagName('p')[0];
            if (username.innerHTML.toUpperCase().indexOf(filter) > -1) {
                items[i].style.display = '';
            } else {
                items[i].style.display = 'none';
            }
        }
    }
</script>
