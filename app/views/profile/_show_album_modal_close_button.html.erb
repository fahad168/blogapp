<div class="relative bg-black rounded-lg shadow dark:bg-gray-700">
  <div class="flex items-center justify-between p-4 md:p-5 border-b rounded-t dark:border-gray-600">
    <h3 class="text-lg font-semibold text-white">
      <%= @album.title %>
    </h3>
    <button type="button" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white" onclick="hideAlbumModal()">
      <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
      </svg>
      <span class="sr-only">Close modal</span>
    </button>
  </div>
  <div class="flex flex-row flex-wrap mt-5 mb-5">
    <% if @album.album_contents.present? %>
      <% @album.album_contents.each do |content| %>
        <a class="card ml-[1.875rem] mt-3 cursor-pointer" data-controller="modal-data" data-action="click-><%= @album.album_type == 'movie' ? 'modal-data#get_movie_data' : 'modal-data#get_season_data' %>" data-movie-id="<%= content.movie_id %>" data-season-id="<%= content.movie_id %>">
          <% if content.img_url.present? %>
            <img src="<%= ENV['TMBD_IMAGE_URL'] %>/w780/<%= content.img_url %>">
          <% else %>
            <img src="<%= asset_path('no_image_found.png') %>" alt="Poster Image">
          <% end %>
          <div class="descriptions flex flex-col justify-between">
            <h1 class="truncate font-bold text-xl"><%= content.original_title %></h1>
            <p class="line-clamp-5"><%= content.description %></p>
            <div class="flex flex-row justify-between">
              <div class="flex flex-row"><p class="text-[red] font-bold">Rating:</p>
                <p class="ml-2 text-sm"><%= content.rating %>/10</p></div>
              <div class="flex flex-row"><p class="text-[red] font-bold">Votes:</p>
                <p class="ml-2 text-sm"><%= content.votes %></p></div>
              <% if content.release_date.present? %>
                <div class="flex flex-row"><p class="text-[red] font-bold">Year:</p>
                  <p class="ml-2 text-sm"><%= content.release_date.split('-').first %></p></div>
              <% end %>
            </div>
          </div>
        </a>
      <% end %>
    <% end %>
  </div>
</div>
