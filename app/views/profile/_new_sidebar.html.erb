<div class="flex flex-col items-center w-40 h-full overflow-hidden text-gray-400 bg-black rounded w-full">
  <div class="w-full px-2">
    <div class="flex flex-col items-center w-full mt-3">
      <a data-turbo="false" class="flex items-center w-full h-12 px-3 mt-2 rounded hover:bg-gray-700 hover:text-gray-300 <%= params[:action] == 'index' ? 'bg-gray-700 text-gray-200' : '' %>" href="/profile">
        <svg class="w-6 h-6 stroke-current" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span class="ml-2 text-sm font-medium">Account</span>
      </a>
      <a data-turbo="false" class="flex items-center w-full h-12 px-3 mt-2 rounded hover:bg-gray-700 hover:text-gray-300 <%= params[:action] == 'albums' ? 'bg-gray-700 text-gray-200' : '' %>" href="/albums">
        <svg class="w-6 h-6 stroke-current" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 3h12a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V5a2 2 0 012-2zm-2 2a2 2 0 012-2h12a2 2 0 012 2m-6 10a2 2 0 110-4 2 2 0 010 4z"/>
        </svg>
        <span class="ml-2 text-sm font-medium">Albums</span>
      </a>
      <a data-turbo="false" class="flex items-center w-full h-12 px-3 mt-2 hover:bg-gray-700 hover:text-gray-300 rounded <%= params[:action] == 'followers' || params[:action] == "pending_requests" ? 'bg-gray-700 text-gray-200' : '' %>" href="/followers">
        <svg class="fill-current h-5 w-5 " viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M16 7C16 9.20914 14.2091 11 12 11C9.79086 11 8 9.20914 8 7C8 4.79086 9.79086 3 12 3C14.2091 3 16 4.79086 16 7ZM14 7C14 8.10457 13.1046 9 12 9C10.8954 9 10 8.10457 10 7C10 5.89543 10.8954 5 12 5C13.1046 5 14 5.89543 14 7Z" fill="currentColor"/>
          <path d="M16 15C16 14.4477 15.5523 14 15 14H9C8.44772 14 8 14.4477 8 15V21H6V15C6 13.3431 7.34315 12 9 12H15C16.6569 12 18 13.3431 18 15V21H16V15Z" fill="currentColor"/>
        </svg>
        <span class="ml-2 text-sm font-medium">Followers</span>
      </a>
      <a data-turbo="false" class="flex items-center w-full h-12 px-3 mt-2 rounded hover:bg-gray-700 hover:text-gray-300 <%= params[:action] == 'followings' || params[:action] == "explore" ? 'bg-gray-700 text-gray-200' : '' %>" href="/followings">
        <svg class="fill-current h-5 w-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M16 7C16 9.20914 14.2091 11 12 11C9.79086 11 8 9.20914 8 7C8 4.79086 9.79086 3 12 3C14.2091 3 16 4.79086 16 7ZM14 7C14 8.10457 13.1046 9 12 9C10.8954 9 10 8.10457 10 7C10 5.89543 10.8954 5 12 5C13.1046 5 14 5.89543 14 7Z" fill="currentColor"/>
          <path d="M16 15C16 14.4477 15.5523 14 15 14H9C8.44772 14 8 14.4477 8 15V21H6V15C6 13.3431 7.34315 12 9 12H15C16.6569 12 18 13.3431 18 15V21H16V15Z" fill="currentColor"/>
        </svg>
        <span class="ml-2 text-sm font-medium">Followings</span>
      </a>
    </div>
    <div class="flex flex-col items-center w-full mt-2 border-t border-gray-700">
      <a data-turbo="false" class="flex items-center w-full h-12 px-3 mt-2 rounded hover:bg-gray-700 hover:text-gray-300 <%= params[:action] == 'settings' ? 'bg-gray-700 text-gray-200' : '' %>" href="/settings">
        <svg class="w-6 h-6 stroke-current" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
        </svg>
        <span class="ml-2 text-sm font-medium">Settings</span>
      </a>
      <a data-turbo="false" class="flex items-center w-full h-12 px-4 mt-2 text-[red] rounded hover:bg-red-800" href="/users/sign_out" data-turbo-method="delete">
        <svg class="h-5 w-5" viewBox="0 0 512 512" fill="red">
          <path d="M377.9 105.9L500.7 228.7c7.2 7.2 11.3 17.1 11.3 27.3s-4.1 20.1-11.3 27.3L377.9 406.1c-6.4 6.4-15 9.9-24 9.9c-18.7 0-33.9-15.2-33.9-33.9l0-62.1-128 0c-17.7 0-32-14.3-32-32l0-64c0-17.7 14.3-32 32-32l128 0 0-62.1c0-18.7 15.2-33.9 33.9-33.9c9 0 17.6 3.6 24 9.9zM160 96L96 96c-17.7 0-32 14.3-32 32l0 256c0 17.7 14.3 32 32 32l64 0c17.7 0 32 14.3 32 32s-14.3 32-32 32l-64 0c-53 0-96-43-96-96L0 128C0 75 43 32 96 32l64 0c17.7 0 32 14.3 32 32s-14.3 32-32 32z"></path>
        </svg>
        <span class="ml-2 text-sm font-medium">Logout</span>
      </a>
    </div>
  </div>
</div>
