<% content_for :title, "User Profile" %>

<main class="max-w-[1920px] mx-auto relative h-screen container" id="indexFile" data-controller="modal-data">
  <%= render "shared/header" %>
  <div class="">
    <%= render 'profile/top_profile' %>
    <div class="flex flex-row justify-center mt-[2rem] lg:mt-0 mt-[5rem]">
      <div class="flex flex-row justify-start md:hidden -mt-5 -ml-3 -mr-3">
        <label class="hamburger absolute">
          <input type="checkbox" onclick="show_sidebar()">
          <svg viewBox="0 0 32 32">
            <path class="line line-top-bottom" d="M27 10 13 10C10.8 10 9 8.2 9 6 9 3.5 10.8 2 13 2 15.2 2 17 3.8 17 6L17 26C17 28.2 18.8 30 21 30 23.2 30 25 28.2 25 26 25 23.8 23.2 22 21 22L7 22"></path>
            <path class="line" d="M7 16 27 16"></path>
          </svg>
        </label>
      </div>
      <div class="md:block hidden border-2 border-[grey] h-[25rem] w-[15%] mt-10 lg:ml-10 ml-5 rounded-lg" id="sidebar">
        <%= render 'profile/new_sidebar' %>
      </div>
      <div class="border-2 border-[grey] lg:w-[50%] w-[80%] mt-10 lg:ml-10 ml-5 rounded-lg lg:h-full h-[25rem] lg:overflow-hidden overflow-auto md:mb-0 mb-[8rem]">
        <%= form_with(url: '/profile/update', method: :post, data: { turbo: false }) do |f| %>
          <div class="profile_input flex flex-col mt-10 lg:pr-[15rem] lg:pl-[15rem] pl-4 pr-4">
            <label class="text-white mb-2">Username</label>
            <input autocomplete="false" name="username" class="shadow appearance-none border rounded w-full py-2 bg-transparent px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline text-white" value="<%= current_user.username %>">
          </div>
          <div class="profile_input flex flex-col mt-3 lg:pr-[15rem] lg:pl-[15rem] pl-4 pr-4">
            <label class="text-white mb-2">Email</label>
            <input autocomplete="false" name="email" class="shadow appearance-none border rounded w-full py-2 bg-transparent px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline text-white" value="<%= current_user.email %>" disabled>
          </div>
          <div class="profile_input flex flex-col mt-3 lg:pr-[15rem] lg:pl-[15rem] pl-4 pr-4">
            <label class="text-white mb-2">Current Password</label>
            <input autocomplete="false" type="password" name="current_password" class="shadow appearance-none border rounded w-full py-2 bg-transparent px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline text-white" placeholder="**********">
          </div>
          <div class="profile_input flex flex-col mt-3 lg:pr-[15rem] lg:pl-[15rem] pl-4 pr-4">
            <label class="text-white mb-2">New Password</label>
            <input autocomplete="false" type="password" name="password" class="shadow appearance-none border rounded w-full py-2 bg-transparent px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline text-white" placeholder="**********">
          </div>
          <div class="profile_input flex flex-col mt-3 lg:pr-[15rem] lg:pl-[15rem] pl-4 pr-4">
            <label class="text-white mb-2">Password Confirmation</label>
            <input autocomplete="false" type="password" name="password_confirmation" class="shadow appearance-none border rounded w-full py-2 bg-transparent px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline text-white" placeholder="**********">
          </div>
          <div class="profile_input flex flex-col mt-10 lg:pr-[15rem] lg:pl-[15rem] pl-4 pr-4 mb-10">
            <button class="bg-red-500 hover:bg-red-400 cursor-pointer text-white font-bold py-2 mt-3 px-4 rounded focus:outline-none focus:shadow-outline">
              Update
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</main>
<%= javascript_include_tag('home/create_album') %>
<%= javascript_include_tag('home/sidebar') %>
