      doneButton.textContent = "Done";
      doneButton.onclick = saveAddress;
      buttonsDiv.appendChild(doneButton)
      addressDiv.appendChild(buttonsDiv)

      $('#address').append(addressDiv);
      var countryId = `#country${addressCount}`
      var cityClassName = `.city-nice-select${addressCount}`
      var stateClassName = `.state-nice-select${addressCount}`
      var i = localStorage.getItem('i')
      await fetchData(i, countryId, `country${addressCount}`)
      localStorage.setItem('i', `${parseInt(i) + 1}`)
      $(stateClassName).niceSelect()
      $(cityClassName).niceSelect()
      $('.country_select').chosen({
          disable_search_threshold: 10,
          placeholder_text_multiple: 'Select Countries',
          no_results_text: 'No country found',
          width: '100%'
      });
      document.getElementById(`country_user${i}`).onchange = getStates.bind(this , document.getElementById(`country_user${i}`), `state_select${addressCount}`, `state_select_div${addressCount}`, `state-nice-select${addressCount}`, "Select State")
      document.getElementById('addressButton').style.display = "none"
      addressCount = parseInt(addressCount) + 1
      localStorage.setItem('addressCount', `${addressCount}`)
  }

  async function fetchData(i, countryId, simpleCountryId) {
      try {
          const response = await $.ajax({
              type: 'GET',
              url: `/country_select?i=${i}`
          });
          $(countryId).html(response.entries);
          var countryError = document.createElement("p");
          countryError.classList.add("text-[red]");
          countryError.id = `country_select${i}`;
          document.getElementById(simpleCountryId).appendChild(countryError)
      } catch (error) {
          console.error('Error:', error);
      }
  }

  function deleteAddress() {
      var addressCount = parseInt(localStorage.getItem('addressCount')) - 1
      var addressFieldsId = `#addressDiv${addressCount}`
      $(addressFieldsId).remove()
      adjustAddAddressButton()
  }

  function saveAddress() {
      var addressCount = parseInt(localStorage.getItem('addressCount')) - 1
      var i = parseInt(localStorage.getItem('i')) - 1
      var valid = check_validations(i, addressCount)
      if (valid) {
          const addressDiv = document.createElement('div');
          addressDiv.setAttribute('class', 'flex flex-row justify-between pl-10 pr-10 pt-3 pb-3 ml-10 mr-10 rounded-md mt-5 shadow-[0_3.166903257369995px_4.750355243682861px_4.750355243682861px_rgba(62,73,84,0.09)]')
          addressDiv.id = `createdAddress${addressCount}`;

          const countryP = document.createElement('input');
          var countryUserChosen = `#country_user${i}_chosen a span`
          countryP.value = $(countryUserChosen)[0].innerHTML
          countryP.classList.add('focus:outline-none', 'w-20')
          countryP.setAttribute("readonly", "true")
          countryP.setAttribute("name", "countries[]")
          addressDiv.appendChild(countryP)

          const stateP = document.createElement('input')
          var stateSelect = `.state-nice-select${addressCount}`
          stateP.classList.add('focus:outline-none', 'w-25')
          stateP.setAttribute("readonly", "true")
          stateP.setAttribute("name", "states[]")
          stateP.value = $(stateSelect)[1].childNodes[0].innerHTML
          addressDiv.appendChild(stateP)

          const cityP = document.createElement('input')
          var citySelect = `.city-nice-select${addressCount}`
          cityP.value = $(citySelect)[1].childNodes[0].innerHTML
          cityP.classList.add('focus:outline-none', 'w-25')
          cityP.setAttribute("readonly", "true")
          cityP.setAttribute("name", "cities[]")
          addressDiv.appendChild(cityP)

          const zipCodeP = document.createElement('input')
          var zipCodeInput = `#zipCode${addressCount}`
          zipCodeP.value = $(zipCodeInput)[0].value
          zipCodeP.classList.add('focus:outline-none', 'w-20')
          zipCodeP.setAttribute("readonly", "true")
          zipCodeP.setAttribute("name", "zipcode[]")
          addressDiv.appendChild(zipCodeP)

          const apartmentP = document.createElement('input')
          var apartmentInput = `#apartment_number${addressCount}`
          apartmentP.value = $(apartmentInput)[0].value
          apartmentP.classList.add('focus:outline-none', 'w-20')
          apartmentP.setAttribute("readonly", "true")
          apartmentP.setAttribute("name", "apartment_number[]")
          addressDiv.appendChild(apartmentP)

          const streetAddressP = document.createElement('input')
          var streetAddressInput = `#street_address${addressCount}`
          streetAddressP.value = $(streetAddressInput)[0].value
          streetAddressP.classList.add('focus:outline-none')
          streetAddressP.setAttribute("readonly", "true")
          streetAddressP.setAttribute("name", "street_address[]")
          addressDiv.appendChild(streetAddressP)

          const iconsDiv = document.createElement('div')
          iconsDiv.setAttribute("class", "flex flex-row justify-end")

          var deleteIcon = document.createElement('img')
          deleteIcon.src = "<%= asset_path('trash.svg') %>"
          deleteIcon.setAttribute('class', 'cursor-pointer hover:opacity-75')
          deleteIcon.onclick = deleteCreatedAddress.bind(this, `#createdAddress${addressCount}`)
          iconsDiv.appendChild(deleteIcon)

          addressDiv.appendChild(iconsDiv)

          $("#savedAddresses")[0].appendChild(addressDiv)
          var addressHideDiv = `#addressDiv${addressCount}`
          $(addressHideDiv)[0].style.display = "none"
          adjustAddAddressButton()
      }
  }

  function adjustAddAddressButton() {
      document.getElementById('addressButton').style.display = "block"
      $('#addressButton')[0].childNodes[1].classList.remove('ml-8')
      $('#addressButton')[0].childNodes[1].classList.add('mr-2')
      $('#addressButton')[0].childNodes[3].classList.add('-mt-8')
  }

  function deleteCreatedAddress(id, icon) {
      $(id).remove()
  }

  function check_validations(chosen_value, addressCount) {
      var inputFields = [
          { id: `#country_user${chosen_value}_chosen a span`, label: `#country_select${chosen_value}`, message: 'Country must be selected' },
          { id: `.state-nice-select${addressCount}`, label: `#state-nice-select${addressCount}`, message: 'State must be selected' },
          { id: `.city-nice-select${addressCount}`, label: `#city-nice-select${addressCount}`, message: 'City must be selected' },
          { id: `#zipCode${addressCount}`, label: `#zipcode-label${addressCount}`, message: "ZipCode can't be empty" },
      ];

      var isValid = true;

      for (var i = 0; i < inputFields.length; i++) {
          var field = ""
          if(inputFields[i].id === `.state-nice-select${addressCount}` || inputFields[i].id === `.city-nice-select${addressCount}`) {
              field = $(inputFields[i].id)[1].childNodes[0].innerHTML
          } else if(inputFields[i].id === `#country_user${chosen_value}_chosen a span`) {
              field = $(inputFields[i].id)[0].innerHTML
          } else {
              field = $(inputFields[i].id)[0].value
          }
          var errorElement = $(inputFields[i].label)[0];
          if (!field || ['Select State', 'Select City', 'Select Country'].includes(field)) {
              errorElement.innerText = inputFields[i].message;
              isValid = false;
          } else {
              errorElement.innerText = '';
          }
      }

      return isValid;
  }

  function deleteSavedAddress(id) {
      var inputField = document.getElementById('deletedAddresses');
      var inputFieldValues = JSON.parse(inputField.value || '[]');
      inputFieldValues.push(id);
      inputField.value = JSON.stringify(inputFieldValues);
      document.getElementById(`createdAddress${id}`).style.display = "none"
  }

</script>
