<script>
  $(document).ready(function () {
      $('.nice-select').niceSelect()
      localStorage.setItem('addressCount', '1')
      localStorage.setItem('i', '1')
  })

  $(function () {
    $('#profile_image').on('change', function (event) {
      var files = event.target.files;
      var image = files[0]
      var reader = new FileReader();
      reader.onload = function (file) {
      var img = new Image();
      img.src = file.target.result;
      img.setAttribute("class", "w-[12rem] h-[12rem] rounded-full absolute object-cover")
      img.setAttribute("id", "user-image")
        $('#user-image').replaceWith(img)
      }
        reader.readAsDataURL(image);
    });
  });

  function rotate_svg(infoArrow, info, closeButton) {
      var arrow = document.getElementById(`${infoArrow}`)
      var infoBox = document.getElementById(`${info}`)
      var infoCloseButton = document.getElementById(`${closeButton}`)
      if (arrow.style.transform === "rotate(180deg)") {
          arrow.style.transform = "rotate(360deg)"
          infoBox.style.display = "grid"
          infoCloseButton.classList.remove('mb-5')
      } else {
          arrow.style.transform = "rotate(180deg)"
          infoBox.style.display = "none"
          infoCloseButton.classList.add('mb-5')
      }
  }

  function getStates(country, id, div_id, className, placeholder) {
      $.ajax({
          type: 'GET',
          url: `/states?country=${country.value}`,
          success: function (res) {
              successResponse(res?.states, id, div_id, className, placeholder)
          }
      })
  }

  function getCities(id, div_id, className, placeholder) {
      var addressCount = parseInt(localStorage.getItem('addressCount')) - 1
      var i = parseInt(localStorage.getItem('i')) - 1
      var stateSelect = `.state-nice-select${addressCount}`
      var state = $(stateSelect)[1].childNodes[0].innerHTML
      var countryChosenId = `#country_user${i}_chosen a span`
      var country = $(countryChosenId)[0].innerHTML
      $.ajax({
          type: 'GET',
          url: `/cities?state=${state}&country=${country}`,
          success: function (res) {
              successResponse(res?.cities, id, div_id, className, placeholder)
          }
      })
  }

  function successResponse(res, id, div_id, className, placeholder) {
      var addressCount = parseInt(localStorage.getItem('addressCount')) - 1
      const selectElement = document.createElement('select');
      selectElement.id = `${id}`;
      selectElement.className = `${className} wide bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5`;
      const defaultOption = document.createElement('option');
      defaultOption.className = 'option selected';
      defaultOption.textContent = `${placeholder}`;
      selectElement.appendChild(defaultOption);
      document.body.appendChild(selectElement);
      if (id === `state_select${addressCount}`){
          selectElement.onchange = getCities.bind(this, `city_select${addressCount}`, `city_select_div${addressCount}`, `city-nice-select${addressCount}`, 'Select City');
      }
      var prevElementId = `#${div_id}`
      const prevSelectElement = $(`${prevElementId}`);
      prevSelectElement.html(selectElement)
      $(`.${className}`).niceSelect()
      const selectElementList = $(`.${className} .list`)[0]
      selectElementList.style.height = "15rem"
      selectElementList.style.overflow = "auto"
      if (id === `state_select${addressCount}`) {
          const cityDiv = document.getElementById(`cityDiv${addressCount}`);
          var cityDivId = `#cityDiv${addressCount}`
          $(cityDivId).empty()
          const cityLabel = document.createElement('label');
          cityLabel.setAttribute('for', 'city');
          cityLabel.classList.add('block', 'mb-2', 'text-sm', 'font-medium', 'text-gray-900');
          cityLabel.textContent = 'City';
          cityDiv.appendChild(cityLabel);

          const citySelectDiv = document.createElement('div');
          citySelectDiv.setAttribute('id', `city_select_div${addressCount}`);
          const citySelect = document.createElement('select');
          citySelect.setAttribute('id', `city_select${addressCount}`);
          citySelect.classList.add(`city-nice-select${addressCount}`, 'wide', 'bg-gray-50', 'border', 'border-gray-300', 'text-gray-900', 'text-sm', 'rounded-lg', 'focus:ring-blue-500', 'focus:border-blue-500', 'block', 'w-full', 'p-2.5');
          const cityOption = document.createElement('option');
          cityOption.textContent = 'Select City';
          cityOption.classList.add('option', 'selected');
          citySelect.appendChild(cityOption);
          citySelectDiv.appendChild(citySelect);
          cityDiv.appendChild(citySelectDiv);
          var cityError = document.createElement("p");
          cityError.classList.add("text-[red]");
          cityError.id = `city-nice-select${addressCount}`;
          cityDiv.appendChild(cityError)

          var classNiceSelect = `.city-nice-select${addressCount}`
          $(classNiceSelect).niceSelect()
      }
      res.forEach((state, index) => {
          const li = document.createElement('li');
          li.className = 'option';
          li.dataset.optionArrayIndex = (index+1).toString();
          if (id === `state_select${addressCount}`) {
              li.textContent = state[0];
          } else {
              li.textContent = state;
          }
          selectElementList.appendChild(li);
      });
  }

  async function addAddress() {
      var addressCount = localStorage.getItem('addressCount')
      const addressDiv = document.createElement('div');
      addressDiv.id = `addressDiv${addressCount}`;
      addressDiv.setAttribute('class', 'ml-10 mr-10 mb-5 pt-5 pb-5 mt-5 rounded-lg shadow-[0_3.166903257369995px_4.750355243682861px_4.750355243682861px_rgba(62,73,84,0.09)]')
      const addressInformationFields = document.createElement('div');
      addressInformationFields.classList.add('grid', 'gap-6', 'mb-6', 'md:grid-cols-2', 'mt-5', 'pl-10', 'pr-10');
      addressInformationFields.id = `addressInformationFields${addressCount}`;

      const countryDiv = document.createElement('div');
      countryDiv.setAttribute('id', `country${addressCount}`);
      addressInformationFields.appendChild(countryDiv);

      const stateDiv = document.createElement('div');
      stateDiv.setAttribute('id', `stateDiv${addressCount}`);
      const stateLabel = document.createElement('label');
      stateLabel.setAttribute('for', `state_select${addressCount}`);
      stateLabel.classList.add('block', 'mb-2', 'text-sm', 'font-medium', 'text-gray-900');
      stateLabel.textContent = 'Province/State';
      stateDiv.appendChild(stateLabel);

      const stateSelectDiv = document.createElement('div');
      stateSelectDiv.setAttribute('id', `state_select_div${addressCount}`);
      const stateSelect = document.createElement('select');
      stateSelect.setAttribute('id', `state_select${addressCount}`);
      stateSelect.setAttribute('name', 'state[]');
      stateSelect.classList.add(`state-nice-select${addressCount}`, 'wide', 'bg-gray-50', 'border', 'border-gray-300', 'text-gray-900', 'text-sm', 'rounded-lg', 'focus:ring-blue-500', 'focus:border-blue-500', 'block', 'w-full', 'p-2.5');
      stateSelect.setAttribute('onchange', `getCities(this, "city_select${addressCount}", "city_select_div${addressCount}" ,"city-nice-select${addressCount}", "Select City")`);
      const stateOption = document.createElement('option');
      stateOption.textContent = 'Select State';
      stateOption.classList.add('option', 'selected');
      stateSelect.appendChild(stateOption);
      stateSelectDiv.appendChild(stateSelect);
      stateDiv.appendChild(stateSelectDiv);

      var stateError = document.createElement("p");
      stateError.classList.add("text-[red]");
      stateError.id = `state-nice-select${addressCount}`;
      stateDiv.appendChild(stateError)
      addressInformationFields.appendChild(stateDiv);

      const cityDiv = document.createElement('div');
      cityDiv.setAttribute('id', `cityDiv${addressCount}`);
      const cityLabel = document.createElement('label');
      cityLabel.setAttribute('for', `city_select${addressCount}`);
      cityLabel.classList.add('block', 'mb-2', 'text-sm', 'font-medium', 'text-gray-900');
      cityLabel.textContent = 'City';
      cityDiv.appendChild(cityLabel);

      const citySelectDiv = document.createElement('div');
      citySelectDiv.setAttribute('id', `city_select_div${addressCount}`);
      const citySelect = document.createElement('select');
      citySelect.setAttribute('id', `city_select${addressCount}`);
      citySelect.setAttribute('name', 'city[]');
      citySelect.classList.add(`city-nice-select${addressCount}`, 'wide', 'bg-gray-50', 'border', 'border-gray-300', 'text-gray-900', 'text-sm', 'rounded-lg', 'focus:ring-blue-500', 'focus:border-blue-500', 'block', 'w-full', 'p-2.5');
      const cityOption = document.createElement('option');
      cityOption.textContent = 'Select City';
      cityOption.classList.add('option', 'selected');
      citySelect.appendChild(cityOption);
      citySelectDiv.appendChild(citySelect);
      cityDiv.appendChild(citySelectDiv);

      var cityError = document.createElement("p");
      cityError.classList.add("text-[red]");
      cityError.id = `city-nice-select${addressCount}`;
      cityDiv.appendChild(cityError)
      addressInformationFields.appendChild(cityDiv);

      const zipCodeDiv = document.createElement('div');
      zipCodeDiv.setAttribute('id', `zipDiv${addressCount}`);
      const zipCodeLabel = document.createElement('label');
      zipCodeLabel.setAttribute('for', `zipCode${addressCount}`);
      zipCodeLabel.classList.add('block', 'mb-2', 'text-sm', 'font-medium', 'text-gray-900');
      zipCodeLabel.textContent = 'ZipCode';
      zipCodeDiv.appendChild(zipCodeLabel);

      const zipCodeInput = document.createElement('input');
      zipCodeInput.setAttribute('type', 'number');
      zipCodeInput.setAttribute('id', `zipCode${addressCount}`);
      zipCodeInput.classList.add('bg-gray-50', 'border', 'border-gray-300', 'text-gray-900', 'text-sm', 'rounded-lg', 'focus:ring-blue-500', 'focus:border-blue-500', 'block', 'w-full', 'p-2.5');
      zipCodeInput.setAttribute('placeholder', 'e.g., 51000');
      zipCodeDiv.appendChild(zipCodeInput);

      var zipError = document.createElement("p");
      zipError.classList.add("text-[red]");
      zipError.id = `zipcode-label${addressCount}`;
      zipCodeDiv.appendChild(zipError)
      addressInformationFields.appendChild(zipCodeDiv);

      const apartmentNumberDiv = document.createElement('div');
      apartmentNumberDiv.setAttribute('id', `apartmentDiv${addressCount}`);
      const apartmentNumberLabel = document.createElement('label');
      apartmentNumberLabel.setAttribute('for', `apartment_number${addressCount}`);
      apartmentNumberLabel.classList.add('block', 'mb-2', 'text-sm', 'font-medium', 'text-gray-900');
