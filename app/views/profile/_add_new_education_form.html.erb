    <ul class="" id="results_list2">
    </ul>
  </div>
</div>
<div class="mt-4">
  <label for="name" class="block mb-2 text-sm font-medium text-gray-900">Skills</label>
  <%#= select_tag("skills", options_for_select([], include_blank: 'Select Skills', selected: "Ruby"), { class: 'languages bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5', id: 'language_select', multiple: true ,placeholder: 'Select Skills'}) %>
  <select multiple id="language_select" class="languages bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5">
  </select>
</div>
<div class="mt-4 flex flex-row justify-between">
  <div>
    <label for="start_date" class="block mb-2 text-sm font-medium text-gray-900">Start Date <span class="text-[red]">*</span></label>
    <input type="text" name="start_date" id="start_date" class="flatpicker w-[15rem] bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" placeholder="Start Date">
  </div>
  <div>
    <label for="end_date" class="block mb-2 text-sm font-medium text-gray-900">End Date (or expected) <span class="text-[red]">*</span></label>
    <input type="text" name="end_date" id="end_date" class="flatpicker w-[15rem] bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" placeholder="End Date">
  </div>
</div>
<div class="mt-4">
  <label for="grades" class="block mb-2 text-sm font-medium text-gray-900">Grade</label>
  <input type="text" name="grades" id="grades" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" placeholder="Ex: A+">
</div>

<script>
  $(document).ready(function () {
      $('.flatpicker').flatpickr({
          shorthandCurrentMonth: true,
          monthSelectorType: "dropdown"
      })
      var select = document.getElementById('language_select')
      var count = 0
      fetch('/languages')
          .then(response => response.text())
          .then(csvData => {
              var rows = csvData.split('\n');
              var headers = rows[0].split(',');
              var nameIndex = headers.indexOf('ProgrammingLanguage');
              rows = rows.slice(1)
              for (let i = 0; i < rows.length; i++) {
                  let columns = rows[i].split(',');
                  let languageName = columns[nameIndex];
                  const option = document.createElement('option')
                  option.innerText = languageName
                  select.appendChild(option)
                  count += 1
              }
              console.log("count =>>>>", count)
              $('.languages').chosen({
                  disable_search_threshold: 10,
                  placeholder_text_multiple: 'Select Skills (Maximum 5)',
                  no_results_text: 'No Skill found',
                  width: '100%',
                  max_selected_options: 5,
              })
          }).catch(error => console.error('Error fetching CSV file:', error));
  })
    function search_schools(input) {
        if (input.value !== "") {
            fetch(`http://universities.hipolabs.com/search?name=${input.value}`)
                .then(response => response.json())
                .then(data => {
                    const resultsList = document.getElementById('results_list');
                    resultsList.innerHTML = '';

                    if (data.length < 2) {
                        document.getElementById('search_div').classList.remove('h-[10rem]')
                        document.getElementById('search_div').classList.add('h-fit')
                    } else {
                        document.getElementById('search_div').classList.add('h-[10rem]')
                        document.getElementById('search_div').classList.remove('h-fit')
                    }
                    data.forEach(university => {
                        const li = document.createElement('li');
                        li.classList.add('p-3', 'cursor-pointer', 'hover:bg-gray-300', 'border-b', 'border-gray-400');
                        li.setAttribute('onclick', `setMajorInputValue("${university.name}", 'school', 'search_div')`)

                        const universityName = document.createElement('p');
                        universityName.classList.add('text-gray-600', 'text-sm', 'font-sans');
                        universityName.textContent = university.name;

                        const universityCountry = document.createElement('p');
                        universityCountry.classList.add('text-[gray]', 'text-sm', 'font-sans', 'mt-1');
                        universityCountry.textContent = university.country;

                        li.appendChild(universityName);
                        li.appendChild(universityCountry);
                        resultsList.appendChild(li);
                        document.getElementById('search_div').classList.remove('hidden')
                    });
                })
                .catch(error => console.error('Error fetching data:', error));
        } else {
            document.getElementById('search_div').classList.add('hidden')
        }
    }

