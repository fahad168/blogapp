    function search_degrees(input, key) {
        var searchInput = input.value.toLowerCase();
        var resultsContainer = document.getElementById(`results_list${key === 'degree' ? '1' : '2'}`);
        var searchDiv = document.getElementById(`search_div${key === 'degree' ? '1' : '2'}`)
        resultsContainer.innerHTML = '';

        fetch('/majors_degrees')
            .then(response => response.text())
            .then(csvData => {
                var rows = csvData.split('\n');
                var headers = rows[0].split(',');
                var nameIndex = headers.indexOf(key === 'degree' ?'Major' : 'Major_Category');
                let addedMajorNames = new Set();

                if (nameIndex === -1) {
                    resultsContainer.innerHTML = '<p>Error: "name" column not found</p>';
                    return;
                }

                function processBatch(startIndex) {
                    const batchSize = 100;
                    // for_loop(startIndex, batchSize, rows, resultsContainer, nameIndex, searchInput)
                    for (let i = startIndex; i < startIndex + batchSize && i < rows.length; i++) {
                        let columns = rows[i].split(',');
                        let majorName = columns[nameIndex].toLowerCase();
                        if (majorName.includes(searchInput) && !addedMajorNames.has(majorName)) {
                            const li = document.createElement('li');
                            li.classList.add('p-3', 'cursor-pointer', 'hover:bg-gray-300', 'border-b', 'border-gray-400');
                            li.setAttribute('onclick', `setMajorInputValue("${majorName.charAt(0).toUpperCase() + majorName.slice(1)}", '${key === 'degree' ? 'degree' : 'field'}', 'search_div${key === 'degree' ? '1' : '2'}')`)
                            const degreeName = document.createElement('p');
                            degreeName.classList.add('text-gray-600', 'text-sm', 'font-sans');
                            degreeName.textContent = majorName.charAt(0).toUpperCase() + majorName.slice(1);

                            li.appendChild(degreeName);
                            resultsContainer.appendChild(li);
                            addedMajorNames.add(majorName);
                        }
                    }
                    if (resultsContainer.childNodes.length === 0) {
                        searchDiv.classList.add('hidden')
                    } else if (resultsContainer.childNodes.length >= 3) {
                        searchDiv.classList.add('h-[10rem]')
                        searchDiv.classList.remove('h-fit')
                        searchDiv.classList.remove('hidden')
                    } else {
                        searchDiv.classList.remove('h-[10rem]')
                        searchDiv.classList.add('h-fit')
                        searchDiv.classList.remove('hidden')
                    }

                    if (startIndex + batchSize < rows.length) {
                        setTimeout(() => processBatch(startIndex + batchSize), 0);
                    }
                }

                processBatch(1);
            })
            .catch(error => console.error('Error fetching CSV file:', error));
    }

  function setMajorInputValue(value, id, div_id) {
      document.getElementById(id).value = value
      document.getElementById(div_id).classList.add('hidden')
  }
