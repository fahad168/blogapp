<div>
  <label for="school" class="block mb-2 text-sm font-medium text-gray-900">School <span class="text-[red]">*</span></label>
  <input type="text" name="school" id="school" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" placeholder="Ex: Oxford University" oninput="search_schools(this)">
  <div class="w-full h-[15rem] overflow-scroll rounded-lg  border border-gray-200 shadow-lg hidden" id="search_div">
    <ul class="" id="results_list">
    </ul>
  </div>
</div>
<div class="mt-4">
  <label for="name" class="block mb-2 text-sm font-medium text-gray-900">Degree <span class="text-[red]">*</span></label>
  <input type="text" name="degree" id="degree" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" placeholder="Ex: Computer Science" oninput="search_degrees(this, 'degree')">
  <div class="w-full overflow-scroll rounded-lg  border border-gray-200 shadow-lg hidden" id="search_div1">
    <ul class="" id="results_list1">
    </ul>
  </div>
</div>
<div class="mt-4">
  <label for="name" class="block mb-2 text-sm font-medium text-gray-900">Field of study <span class="text-[red]">*</span></label>
  <input type="text" name="field" id="field" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" placeholder="Ex: Arts" oninput="search_degrees(this, 'field')">
